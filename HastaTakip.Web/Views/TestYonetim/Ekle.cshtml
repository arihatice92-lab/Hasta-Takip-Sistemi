@model HastaTakip.Entities.Test

@{
    ViewData["Title"] = "Yeni Test Ekle";
}

<h2>Yeni Test Ekle</h2>

<div asp-validation-summary="ModelOnly" class="text-danger"></div>

<form asp-action="Ekle" method="post">
    <div class="mb-3">
        <label asp-for="TestAdi" class="form-label">Test Adı <span style="color:red">*</span></label>
        <input asp-for="TestAdi" class="form-control" required />
    </div>
    <div class="mb-3">
        <label asp-for="TestBilgi" class="form-label">Bilgi</label>
        <textarea asp-for="TestBilgi" class="form-control"></textarea>
    </div>
    <button type="submit" class="btn btn-primary">Kaydet</button>
    <a asp-action="Index" class="btn btn-secondary">İptal</a>
</form>