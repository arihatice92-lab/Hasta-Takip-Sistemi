<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Hasta Takip Sistemi</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/HastaTakip.Web.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Dashboard" asp-action="Index">Hasta Takip Sistemi</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Dashboard" asp-action="Index">Ana Sayfa</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Hasta" asp-action="Index">Hasta Listesi</a>
                            </li>

                            @if (User.IsInRole("Yönetici") || User.IsInRole("Sekreter"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-controller="Doktor" asp-action="Index">Doktor Listesi</a>
                                </li>
                            }

                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Randevu" asp-action="Index">Randevu Listesi</a>
                            </li>
                           
                            @if (User.IsInRole("Yönetici"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-controller="Kullanici" asp-action="Index">Kullanıcı Yönetimi</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-controller="TestYonetim" asp-action="Index">Test Yönetimi</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-controller="OlcekYonetim" asp-action="Index">Ölçek Yönetimi</a>
                                </li>
                            }
                            @if (User.IsInRole("Doktor"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-controller="DoktorPaneli" asp-action="Index">Doktor Panelim</a>
                                </li>
                            }

                        }
                    </ul>

                    <ul class="navbar-nav">
                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle text-dark" href="#" id="kullaniciMenu" role="button"
                                   data-bs-toggle="dropdown" aria-expanded="false">
                                    @User.FindFirst("AdSoyad")?.Value
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="kullaniciMenu">
                                    <li>
                                        <h6 class="dropdown-header">
                                            @User.Identity.Name
                                            <br />
                                            <small class="text-muted">@User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value</small>
                                        </h6>
                                    </li>
                                    <li><hr class="dropdown-divider" /></li>
                                    <li>
                                        <a class="dropdown-item" asp-controller="Account" asp-action="SifreDegistir">Şifre Değiştir</a>
                                    </li>
                                    <li>
                                        <form asp-controller="Account" asp-action="Logout" method="post" class="px-3">
                                            <button type="submit" class="btn btn-link dropdown-item p-0 text-danger">Çıkış Yap</button>
                                        </form>
                                    </li>
                                </ul>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Account" asp-action="Login">Giriş Yap</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - Hasta Takip Sistemi Web Uygulaması - <a asp-area="" asp-controller="Home" asp-action="Privacy">Gizlilik</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <script>
            document.addEventListener('DOMContentLoaded', function() {
                var basariMesajlari = document.querySelectorAll('.alert-success');
                basariMesajlari.forEach(function(mesaj) {
                    setTimeout(function() {
                        var bsAlert = bootstrap.Alert.getOrCreateInstance(mesaj);
                        bsAlert.close();
                    }, 3000);
                });
            });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>