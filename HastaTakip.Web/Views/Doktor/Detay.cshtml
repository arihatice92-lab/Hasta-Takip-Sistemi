@model HastaTakip.Entities.Doktor

@{
    ViewData["Title"] = "Doktor Detayı";
    var izinler = (List<HastaTakip.Entities.DoktorIzni>)ViewBag.Izinler;
}

<h2>Doktor Detayı</h2>
@if (TempData["BasariMesaji"] != null)
{
    <div class="alert alert-success">@TempData["BasariMesaji"]</div>
}
@if (TempData["HataMesaji"] != null)
{
    <div class="alert alert-danger">@TempData["HataMesaji"]</div>
}

@if (ViewBag.Cakismalar != null)
{
    var cakismalar = (List<HastaTakip.Entities.RandevuCakismasi>)ViewBag.Cakismalar;

    <div class="card border-danger mb-4">
        <div class="card-header bg-danger text-white">
            Çakışan Randevular (@cakismalar.Count)
        </div>
        <div class="card-body p-0">
            <table class="table table-sm mb-0">
                <thead>
                    <tr>
                        <th>Tarih</th>
                        <th>Saat</th>
                        <th>Hasta</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var c in cakismalar)
                    {
                        <tr>
                            <td>@c.RandevuTarih.ToString("dd.MM.yyyy dddd")</td>
                            <td>@c.Saat.ToString(@"hh\:mm")</td>
                            <td>@c.HastaAdSoyad</td>
                            <td>
                                <a asp-controller="Randevu" asp-action="Detay" asp-route-randevuTarihID="@c.RandevuTarihID" class="btn btn-sm btn-outline-primary">
                                    Randevuya Git
                                </a>
                                <a asp-controller="Randevu" asp-action="YenidenPlanla" asp-route-randevuTarihID="@c.RandevuTarihID" class="btn btn-sm btn-warning">
                                    Yeniden Planla
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
<dl class="row">
    <dt class="col-sm-3">Sicil No</dt>
    <dd class="col-sm-9">@Model.DoktorSicilNo</dd>

    <dt class="col-sm-3">Ad Soyad</dt>
    <dd class="col-sm-9">@Model.DoktorAd @Model.DoktorSoyad</dd>

    <dt class="col-sm-3">Telefon</dt>
    <dd class="col-sm-9">@Model.DoktorTel</dd>

    <dt class="col-sm-3">Branş</dt>
    <dd class="col-sm-9">@Model.DoktorBrans</dd>

    <dt class="col-sm-3">Kurum Başlangıç Tarihi</dt>
    <dd class="col-sm-9">@(Model.DoktorKurumBaslangicTarih?.ToString("dd.MM.yyyy") ?? "-")</dd>

    <dt class="col-sm-3">Durum</dt>
    <dd class="col-sm-9">
        @if (Model.DoktorKurumAyrilisTarih == null)
        {
            <span class="badge bg-success">Aktif</span>
        }
        else
        {
            <span>Ayrılış Tarihi: @Model.DoktorKurumAyrilisTarih?.ToString("dd.MM.yyyy")</span>
        }
    </dd>
</dl>

@if (User.IsInRole("Yönetici") || User.IsInRole("Sekreter"))
{
    <a asp-action="Guncelle" asp-route-doktorID="@Model.DoktorID" class="btn btn-warning">Düzenle</a>
    <a asp-action="Index" class="btn btn-secondary">Listeye Dön</a>
}
else
{
    <a asp-controller="DoktorPaneli" asp-action="Index" class="btn btn-secondary">Panelime Dön</a>
}
@if (User.IsInRole("Yönetici") || User.IsInRole("Sekreter"))
{
    @if (Model.DoktorKurumAyrilisTarih == null)
    {
        <form asp-action="Ayrilis" method="post" class="d-inline">
            <input type="hidden" name="doktorID" value="@Model.DoktorID" />
            <button type="submit" class="btn btn-danger"
            onclick="return confirm('Bu doktorun kurumdan ayrıldığını işaretlemek istediğinize emin misiniz?');">
                Kurumdan Ayrıldı Olarak İşaretle
            </button>
        </form>
    }
}

<hr class="my-4" />

<h5>İzin / Rapor Kayıtları</h5>

<form asp-action="IzinEkle" method="post" class="row g-2 mb-4">
    <input type="hidden" name="DoktorID" value="@Model.DoktorID" />
    <div class="col-md-2">
        <label class="form-label">İzin Türü</label>
        <select name="IzinTuru" class="form-select" required>
            <option value="">Tür Seçin</option>
            <option value="Yıllık İzin">Yıllık İzin</option>
            <option value="Ücretsiz İzin">Ücretsiz İzin</option>
            <option value="Rapor">Rapor</option>
            <option value="Mazeret İzni">Mazeret İzni</option>
            <option value="Diğer">Diğer</option>
        </select>
    </div>
    <div class="col-md-2">
        <label class="form-label">İzin Başlangıç Tarihi</label>
        <input type="date" name="BaslangicTarihi" class="form-control" required />
    </div>
    <div class="col-md-2">
        <label class="form-label">İzin Bitiş Tarihi</label>
        <input type="date" name="BitisTarihi" class="form-control" required />
    </div>
    <div class="col-md-3">
        <label class="form-label">Ek Açıklama</label>
        <input type="text" name="Aciklama" class="form-control" placeholder="Açıklama (opsiyonel)" />
    </div>
    <div class="col-md-2">
        <label class="form-label invisible">Ekle</label>
        <button type="submit" class="btn btn-primary w-100" >Ekle</button>
    </div>
</form>

@if (izinler.Count == 0)
{
    <p class="text-muted">Kayıtlı izin/rapor bulunmuyor.</p>
}
else
{
    <table class="table table-striped table-sm">
        <thead>
            <tr><th>Tür</th><th>Başlangıç</th><th>Bitiş</th><th>Açıklama</th><th></th></tr>
        </thead>
        <tbody>
            @foreach (var izin in izinler)
            {
                <tr>
                    <td>@izin.IzinTuru</td>
                    <td>@izin.BaslangicTarihi.ToString("dd.MM.yyyy")</td>
                    <td>@izin.BitisTarihi.ToString("dd.MM.yyyy")</td>
                    <td>@(izin.Aciklama ?? "-")</td>
                    <td>
                        <form asp-action="IzinSil" method="post" class="d-inline">
                            <input type="hidden" name="izinID" value="@izin.IzinID" />
                            <input type="hidden" name="doktorID" value="@Model.DoktorID" />
                            <button type="submit" class="btn btn-sm btn-danger"
                                    onclick="return confirm('Bu izin kaydını silmek istediğinize emin misiniz?');">
                                Sil
                            </button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}