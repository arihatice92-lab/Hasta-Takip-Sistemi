@{
    ViewData["Title"] = "Randevuyu Yeniden Planla";
    var randevu = (HastaTakip.Entities.PsikologRandevuTarihi)ViewBag.Randevu;
    var hasta = (HastaTakip.Entities.Hasta?)ViewBag.Hasta;
    var psikologlar = (List<HastaTakip.Entities.Psikolog>)ViewBag.PsikologListesi;
    var saatler = (List<HastaTakip.Entities.PsikologRandevuSaat>)ViewBag.SaatListesi;
}

<h2>Randevuyu Yeniden Planla</h2>

<div class="alert alert-info">
    <strong>Hasta:</strong> @(hasta != null ? $"{hasta.HastaAd} {hasta.HastaSoyad}" : "-")<br />
    <strong>Mevcut Tarih:</strong> @randevu.RandevuTarih.ToString("dd.MM.yyyy")
</div>

<a asp-action="Takvim" asp-route-psikologID="@randevu.PsikologID" asp-route-randevuTarihID="@randevu.RandevuTarihID" class="btn btn-outline-primary mb-3">
    Takvimden Uygun Saat Seç
</a>

<form asp-action="YenidenPlanla" method="post">
    <input type="hidden" name="randevuTarihID" value="@randevu.RandevuTarihID" />

    <div class="row">
        <div class="col-md-4">
            <label class="form-label">Psikolog <span style="color:red">*</span></label>
            <select name="yeniPsikologID" class="form-select" required>
                @foreach (var psikolog in psikologlar)
                {
                    <option value="@psikolog.PsikologID" selected="@(psikolog.PsikologID == (byte)ViewBag.OnSeciliPsikologID)">
                        @psikolog.PsikologAd @psikolog.PsikologSoyad
                    </option>
                }
            </select>
        </div>

        <div class="col-md-3">
            <label class="form-label">Yeni Tarih <span style="color:red">*</span></label>
            <input type="date" name="yeniTarih" class="form-control" value="@(((DateTime)ViewBag.OnSeciliTarih).ToString("yyyy-MM-dd"))" required />
        </div>

        <div class="col-md-3">
            <label class="form-label">Saat <span style="color:red">*</span></label>
            <select name="yeniSaatID" class="form-select" required>
                @foreach (var saat in saatler)
                {
                    <option value="@saat.SaatID" selected="@(saat.SaatID == (byte)ViewBag.OnSeciliSaatID)">
                        @saat.RandevuBaslangicSaat.ToString(@"hh\:mm") - @saat.RandevuBitisSaat.ToString(@"hh\:mm")
                    </option>
                }
            </select>
        </div>
    </div>

    <button type="submit" class="btn btn-primary mt-3">Kaydet</button>
    <a asp-action="Detay" asp-route-randevuTarihID="@randevu.RandevuTarihID" class="btn btn-secondary mt-3">İptal</a>
</form>