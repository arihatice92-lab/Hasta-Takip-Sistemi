@model HastaTakip.Entities.PsikologRandevuTarihi

@{
    ViewData["Title"] = "Randevu Detayı";
    var hasta = (HastaTakip.Entities.Hasta?)ViewBag.Hasta;
    var psikolog = (HastaTakip.Entities.Psikolog?)ViewBag.Psikolog;
    var saat = (HastaTakip.Entities.PsikologRandevuSaat?)ViewBag.Saat;
}




@if (TempData["HataMesaji"] != null)
{
    <div class="alert alert-danger">@TempData["HataMesaji"]</div>
}

<dl class="row">
    <dt class="col-sm-3">Tarih</dt>
    <dd class="col-sm-9">@Model.RandevuTarih.ToString("dd.MM.yyyy")</dd>

    <dt class="col-sm-3">Saat</dt>
    <dd class="col-sm-9">@(saat != null ? saat.RandevuBaslangicSaat.ToString(@"hh\:mm") + " - " + saat.RandevuBitisSaat.ToString(@"hh\:mm") : "-")</dd>

    <dt class="col-sm-3">Hasta</dt>
    <dd class="col-sm-9">@(hasta != null ? $"{hasta.HastaAd} {hasta.HastaSoyad}" : "-")</dd>

    <dt class="col-sm-3">Psikolog</dt>
    <dd class="col-sm-9">@(psikolog != null ? $"{psikolog.PsikologAd} {psikolog.PsikologSoyad}" : "-")</dd>

    <dt class="col-sm-3">Durum</dt>
    <dd class="col-sm-9">@Model.RandevuDurum</dd>
</dl>


@if (User.IsInRole("Yönetici") ||
ViewBag.GirisYapanPsikologID == Model.PsikologID)
{
    <a asp-controller="TestSonuc"
       asp-action="Ekle"
       asp-route-hastaTC="@Model.HastaTC"
       class="btn btn-sm btn-primary">
        Test Sonucu Ekle
    </a>
}
else
{
    <button type="button"
            class="btn btn-sm btn-secondary"
            disabled>
        Test Sonucu Ekle
    </button>
}

<a asp-action="Index" class="btn btn-secondary">Listeye Dön</a>