@model List<HastaTakip.Entities.PsikologRandevuTarihi>

@{
    ViewData["Title"] = "Psikolog Randevuları";
    var hastalar = (Dictionary<string, HastaTakip.Entities.Hasta>)ViewBag.Hastalar;
    var psikologlar = (Dictionary<byte, HastaTakip.Entities.Psikolog>)ViewBag.Psikologlar;
    var saatler = (Dictionary<byte, HastaTakip.Entities.PsikologRandevuSaat>)ViewBag.Saatler;
}

<h2>Psikolog Randevuları</h2>

@if (TempData["BasariMesaji"] != null)
{
    <div class="alert alert-success">@TempData["BasariMesaji"]</div>
}
@if (TempData["HataMesaji"] != null)
{
    <div class="alert alert-danger">@TempData["HataMesaji"]</div>
}

<p>
    <a asp-action="Ekle" class="btn btn-primary">Yeni Randevu Oluştur</a>
    <a asp-action="Takvim" class="btn btn-outline-primary">Psikolog Takvimini Görüntüle</a>
</p>

<form asp-action="Index" method="get" class="row g-2 mb-4">
    <div class="col-md-2">
        <input type="text" name="ara" value="@ViewBag.Ara" class="form-control" placeholder="Hasta ara..." />
    </div>
    <div class="col-md-2">
        <input type="date" name="baslangicTarihi" value="@(ViewBag.Baslangic?.ToString("yyyy-MM-dd"))" class="form-control" />
    </div>
    <div class="col-md-2">
        <input type="date" name="bitisTarihi" value="@(ViewBag.Bitis?.ToString("yyyy-MM-dd"))" class="form-control" />
    </div>
    <div class="col-md-2">
        <select name="psikologID" class="form-select">
            <option value="">Tümü</option>
            @foreach (var psikolog in (List<HastaTakip.Entities.Psikolog>)ViewBag.PsikologListesi)
            {
                <option value="@psikolog.PsikologID" selected="@(psikolog.PsikologID.ToString() == Context.Request.Query["psikologID"])">
                    @psikolog.PsikologAd @psikolog.PsikologSoyad
                </option>
            }
        </select>
    </div>
    <div class="col-md-2">
        <select name="durum" class="form-select">
            <option value="">Tümü</option>
            <option value="Planlandı" selected="@(ViewBag.SeciliDurum == "Planlandı")">Planlandı</option>
            <option value="Tamamlandı" selected="@(ViewBag.SeciliDurum == "Tamamlandı")">Tamamlandı</option>
            <option value="İptal" selected="@(ViewBag.SeciliDurum == "İptal")">İptal</option>
            <option value="Gelmedi" selected="@(ViewBag.SeciliDurum == "Gelmedi")">Gelmedi</option>
        </select>
    </div>
    <div class="col-md-2 d-flex gap-2">
        <button type="submit" class="btn btn-primary">Ara</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Temizle</a>
    </div>
</form>

<table class="table table-striped">
    <thead>
        <tr><th>Tarih</th><th>Saat</th><th>Hasta</th><th>Psikolog</th><th>Durum</th><th>İşlemler</th></tr>
    </thead>
    <tbody>
        @foreach (var randevu in Model)
        {
            var hastaVarMi = hastalar.TryGetValue(randevu.HastaTC, out var hasta);
            var detayUrl = Url.Action("Detay", "PsikologRandevu", new { randevuTarihID = randevu.RandevuTarihID });

            <tr class="randevu-satiri" data-href="@detayUrl" style="cursor:pointer;">
                <td>@randevu.RandevuTarih.ToString("dd.MM.yyyy")</td>
                <td>@(saatler.TryGetValue(randevu.SaatID, out var saat) ? saat.RandevuBaslangicSaat.ToString(@"hh\:mm") : "-")</td>
                <td>@(hastaVarMi ? $"{hasta!.HastaAd} {hasta.HastaSoyad}" : "-")</td>
                <td>@(psikologlar.TryGetValue(randevu.PsikologID, out var psikolog) ? $"{psikolog.PsikologAd} {psikolog.PsikologSoyad}" : "-")</td>
                <td>
                    @{
                        var renk = randevu.RandevuDurum switch
                        {
                            "Tamamlandı" => "bg-success",
                            "İptal" => "bg-secondary",
                            "Gelmedi" => "bg-danger",
                            _ => "bg-primary"
                        };
                    }
                    <span class="badge @renk">@randevu.RandevuDurum</span>
                </td>
                <td>
                    <a asp-action="Detay" asp-route-randevuTarihID="@randevu.RandevuTarihID" class="btn btn-sm btn-info">Detay</a>
                    @if (randevu.RandevuDurum == "Planlandı")
                    {
                        @if (randevu.TestBaslangicZamani.HasValue)
                        {
                            <form asp-action="Tamamlandi" method="post" class="d-inline">
                                <input type="hidden" name="randevuTarihID" value="@randevu.RandevuTarihID" />
                                <button type="submit" class="btn btn-sm btn-success">Tamamlandı</button>
                            </form>
                        }
                        else if (randevu.HastaGelisZamani.HasValue)
                        {
                            <form asp-action="TestBaslat" method="post" class="d-inline">
                                <input type="hidden" name="randevuTarihID" value="@randevu.RandevuTarihID" />
                                <button type="submit" class="btn btn-sm btn-primary">Testi Başlat</button>
                            </form>
                        }
                        else
                        {
                            <form asp-action="Geldi" method="post" class="d-inline">
                                <input type="hidden" name="randevuTarihID" value="@randevu.RandevuTarihID" />
                                <button type="submit" class="btn btn-sm btn-outline-info">Kayıt Aç</button>
                            </form>
                        }
                        <form asp-action="Gelmedi" method="post" class="d-inline">
                            <input type="hidden" name="randevuTarihID" value="@randevu.RandevuTarihID" />
                            <button type="submit" class="btn btn-sm btn-warning">Gelmedi</button>
                        </form>
                        <form asp-action="Iptal" method="post" class="d-inline">
                            <input type="hidden" name="randevuTarihID" value="@randevu.RandevuTarihID" />
                            <button type="submit" class="btn btn-sm btn-secondary"
                                    onclick="return confirm('Bu randevuyu iptal etmek istediğinize emin misiniz?');">
                                İptal
                            </button>
                        </form>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>

@if (ViewBag.ToplamSayfa > 1)
{
    <nav>
        <ul class="pagination">
            @for (int i = 1; i <= ViewBag.ToplamSayfa; i++)
            {
                <li class="page-item @(i == ViewBag.SayfaNo ? "active" : "")">
                    <a class="page-link" asp-action="Index"
                       asp-route-ara="@(ViewBag.Ara ?? "")"
                       asp-route-baslangicTarihi="@(ViewBag.Baslangic?.ToString("yyyy-MM-dd") ?? "")"
                       asp-route-bitisTarihi="@(ViewBag.Bitis?.ToString("yyyy-MM-dd") ?? "")"
                       asp-route-psikologID="@(ViewBag.SeciliPsikologID?.ToString() ?? "")"
                       asp-route-durum="@(ViewBag.SeciliDurum ?? "")"
                       asp-route-sayfa="@i">@i</a>
                </li>
            }
        </ul>
    </nav>
}

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            document.querySelectorAll('.randevu-satiri').forEach(function(satir) {
                satir.addEventListener('click', function(e) {
                    if (e.target.closest('a, button, form, input, select')) return;
                    window.location = satir.dataset.href;
                });
            });
        });
    </script>
}