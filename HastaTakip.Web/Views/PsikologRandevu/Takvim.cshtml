@using System.Linq
@{
    ViewData["Title"] = "Psikolog Takvimi";
    var psikologlar = (List<HastaTakip.Entities.Psikolog>)ViewBag.PsikologListesi;
    byte? seciliPsikologID = ViewBag.SeciliPsikologID;
    DateTime baslangicTarih = ViewBag.BaslangicTarih;
}

<h2>Psikolog Takvimi</h2>

<form asp-action="Takvim" method="get" class="row g-3 mb-4">
    <input type="hidden" name="hastaTC" value="@ViewBag.HastaTC" />
    <input type="hidden" name="randevuTarihID" value="@ViewBag.RandevuTarihID" />
    <div class="col-md-4">
        <label class="form-label">Psikolog</label>
        <select name="psikologID" class="form-select" required>
            <option value="">Seçiniz</option>
            @foreach (var psikolog in psikologlar)
            {
                <option value="@psikolog.PsikologID" selected="@(psikolog.PsikologID == seciliPsikologID)">
                    @psikolog.PsikologAd @psikolog.PsikologSoyad
                </option>
            }
        </select>
    </div>
    <div class="col-md-3">
        <label class="form-label">Başlangıç Tarihi</label>
        <input type="date" name="tarih" value="@baslangicTarih.ToString("yyyy-MM-dd")" class="form-control" />
    </div>
    <div class="col-md-2 d-flex align-items-end">
        <button type="submit" class="btn btn-primary w-100">Göster</button>
    </div>
</form>

@if (seciliPsikologID.HasValue)
{
    var haftaBasi = ((DateTime)ViewBag.HaftaBasi).Date;
    var toplamGun = (int)ViewBag.ToplamGun;
    var gunlukDurumlar = ((List<HastaTakip.Entities.PsikologTakvimGunu>)ViewBag.GunlukDurumlar).ToDictionary(g => g.Tarih.Date);
    var aralikBaslangic = ((DateTime)ViewBag.AralikBaslangic).Date;
    var aralikBitis = ((DateTime)ViewBag.AralikBitis).Date;
    var haftaSayisi = toplamGun / 7;

    <div class="table-responsive mb-4">
        <table class="table table-bordered text-center align-middle table-sm" style="table-layout:fixed;">
            <thead class="table-light">
                <tr><th>Pzt</th><th>Sal</th><th>Çar</th><th>Per</th><th>Cum</th><th>Cmt</th><th>Paz</th></tr>
            </thead>
            <tbody>
                @for (int hafta = 0; hafta < haftaSayisi; hafta++)
                {
                    <tr>
                        @for (int gun = 0; gun < 7; gun++)
                        {
                            var gunTarih = haftaBasi.AddDays(hafta * 7 + gun);
                            bool haftaSonu = gunTarih.DayOfWeek == DayOfWeek.Saturday || gunTarih.DayOfWeek == DayOfWeek.Sunday;
                            var araligaDahilMi = gunTarih >= aralikBaslangic && gunTarih <= aralikBitis;
                            gunlukDurumlar.TryGetValue(gunTarih, out var durum);
                            bool izinliMi = araligaDahilMi && durum != null && durum.IzinliMi;
                            bool musait = araligaDahilMi && durum != null && !durum.IzinliMi && durum.TamamenMusait;
                            

                            <td class="p-0 @(!araligaDahilMi ? "bg-light" : "")" style="height:60px;">
                                @if (haftaSonu)
                                {
                                    <div class="p-2 h-100 text-muted bg-light">
                                        <div><strong>@gunTarih.Day</strong></div>
                                        <small>Kapalı</small>
                                    </div>
                                }
                                else if (izinliMi)
                                {
                                    <div class="p-2 h-100 text-white bg-secondary" style="opacity: 0.7;">
                                        <div><strong>@gunTarih.Day</strong></div>
                                        <small>Kapalı</small>
                                    </div>
                                }
                                
                                else if (musait)
                                {
                                    <a asp-action="Takvim"
                                       asp-route-psikologID="@seciliPsikologID"
                                       asp-route-tarih="@baslangicTarih.ToString("yyyy-MM-dd")"
                                       asp-route-hastaTC="@ViewBag.HastaTC"
                                       asp-route-randevuTarihID="@ViewBag.RandevuTarihID"
                                       asp-route-secilenGun="@gunTarih.ToString("yyyy-MM-dd")"
                                       class="d-block h-100 w-100 text-white text-decoration-none p-2 bg-success">
                                        <div><strong>@gunTarih.Day</strong></div>
                                        <small>@durum!.DoluSaat/@durum.ToplamSaat</small>
                                    </a>
                                }
                                else if (araligaDahilMi && durum != null)
                                {
                                    <div class="p-2 h-100 text-white bg-danger">
                                        <div><strong>@gunTarih.Day</strong></div>
                                        <small>@durum.DoluSaat/@durum.ToplamSaat</small>
                                    </div>
                                }
                                else
                                {
                                    <div class="p-2 h-100 text-muted">@gunTarih.Day</div>
                                }
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (ViewBag.SecilenGun != null)
    {
        DateTime secilenGun = ViewBag.SecilenGun;
        var slotlar = (List<HastaTakip.Entities.PsikologTakvimSlotu>)ViewBag.SecilenGunSlotlari;

        <h5>@secilenGun.ToString("dd.MM.yyyy dddd") — Saatler</h5>
        <div class="d-flex flex-wrap gap-2 mb-4">
            @foreach (var slot in slotlar)
            {
                var saatMetin = slot.BaslangicSaat.ToString(@"hh\:mm") + " - " + slot.BitisSaat.ToString(@"hh\:mm");
                if (slot.Dolu)
                {
                    <div class="p-3 rounded text-white text-center bg-danger" style="min-width:140px;">
                        <strong>@saatMetin</strong><br /><small>Dolu</small>
                    </div>
                }
                else if (ViewBag.RandevuTarihID != null)
                {
                    <a asp-action="YenidenPlanla"
                       asp-route-randevuTarihID="@ViewBag.RandevuTarihID"
                       asp-route-yeniPsikologID="@seciliPsikologID"
                       asp-route-yeniTarih="@secilenGun.ToString("yyyy-MM-dd")"
                       asp-route-yeniSaatID="@slot.SaatID"
                       class="p-3 rounded text-white text-decoration-none text-center bg-success" style="min-width:140px;">
                        <strong>@saatMetin</strong><br /><small>Bu Saate Taşı</small>
                    </a>
                }
                else
                {
                    <a asp-action="Ekle"
                       asp-route-psikologID="@seciliPsikologID"
                       asp-route-tarih="@secilenGun.ToString("yyyy-MM-dd")"
                       asp-route-saatID="@slot.SaatID"
                       asp-route-hastaTC="@ViewBag.HastaTC"
                       class="p-3 rounded text-white text-decoration-none text-center bg-success" style="min-width:140px;">
                        <strong>@saatMetin</strong><br /><small>Müsait</small>
                    </a>
                }
            }
        </div>
    }
}