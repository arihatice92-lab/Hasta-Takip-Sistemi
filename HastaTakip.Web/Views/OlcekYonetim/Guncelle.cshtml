@model HastaTakip.Entities.Olcek

@{
    ViewData["Title"] = "Guncelle";
}

<h2>Ölçeği Güncelle</h2>

<div asp-validation-summary="ModelOnly" class="text-danger"></div>

<form asp-action="Guncelle" method="post">
    <input type="hidden" asp-for="OlcekID" />
    <div class="mb-3">
        <label asp-for="OlcekAdi" class="form-label">Ölçek Adı <span style="color:red">*</span></label>
        <input asp-for="OlcekAdi" class="form-control" required />
    </div>
    <div class="mb-3">
        <label asp-for="OlcekBilgi" class="form-label">Bilgi</label>
        <textarea asp-for="OlcekBilgi" class="form-control"></textarea>
    </div>
    <button type="submit" class="btn btn-primary">Güncelle</button>
    <a asp-action="Index" class="btn btn-secondary">İptal</a>
</form>