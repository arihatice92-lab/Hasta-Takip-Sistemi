@model List<HastaTakip.Entities.Olcek>

@{
    ViewData["Title"] = "Ölçek Yönetimi";
}

<h2>Ölçek Yönetimi</h2>

@if (TempData["BasariMesaji"] != null)
{
    <div class="alert alert-success">@TempData["BasariMesaji"]</div>
}
@if (TempData["HataMesaji"] != null)
{
    <div class="alert alert-danger">@TempData["HataMesaji"]</div>
}

<a asp-action="Ekle" class="btn btn-primary mb-3">Yeni Ölçek Ekle</a>

<table class="table table-striped">
    <thead>
        <tr><th>Ölçek Adı</th><th>Bilgi</th><th>İşlemler</th></tr>
    </thead>
    <tbody>
        @foreach (var olcek in Model)
        {
            <tr>
                <td>@olcek.OlcekAdi</td>
                <td>@(olcek.OlcekBilgi ?? "-")</td>
                <td>
                    <a asp-action="Guncelle" asp-route-olcekID="@olcek.OlcekID" class="btn btn-sm btn-warning">Düzenle</a>
                    
                    <form asp-action="Sil" method="post" class="d-inline">
                        <input type="hidden" name="testID" value="@olcek.OlcekID" />
                        <button type="submit" class="btn btn-sm btn-danger"
                                onclick="return confirm('Bu testi silmek istediğinize emin misiniz?');">
                            Sil
                        </button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>