@model HastaTakip.Entities.Kullanici

@{
    ViewData["Title"] = "Yeni Kullanıcı Ekle";
    var doktorlar = (List<HastaTakip.Entities.Doktor>)ViewBag.DoktorListesi;
    var psikologlar = (List<HastaTakip.Entities.Psikolog>)ViewBag.PsikologListesi;
}

<h2>Yeni Kullanıcı Ekle</h2>

<div asp-validation-summary="ModelOnly" class="text-danger"></div>

<form asp-action="Ekle" method="post">
    <div class="p-2 mb-3 bg-info-subtle border border-info-subtle rounded small">
        Şifreniz en az 8 karakter olmalı; en az bir büyük harf, bir küçük harf, bir rakam ve bir özel karakter (!@@#$% gibi) içermelidir.
    </div>
    <div class="mb-3">
        <label>Kullanıcı Adı</label>
        <input asp-for="KullaniciAdi" class="form-control" required />
    </div>

    <div class="mb-3">
        <label>Ad Soyad</label>
        <input asp-for="AdSoyad" class="form-control" required />
    </div>

    <div class="mb-3">
        <label>Başlangıç Şifresi</label>
        <input type="password" name="sifre" class="form-control" required minlength="6" />
    </div>

    <div class="mb-3">
        <label>Rol</label>
        <select asp-for="RolID" class="form-control">
            <option value="1">Yönetici</option>
            <option value="2">Doktor</option>
            <option value="3">Sekreter</option>
            <option value="4">Psikolog</option>
        </select>
    </div>
    <div class="mb-3" id="doktorSeciciAlani">
        <label class="form-label">Bağlı Doktor</label>
        <select name="DoktorID" class="form-select">
            <option value="">Yok</option>
            @foreach (var doktor in doktorlar)
            {
                <option value="@doktor.DoktorID">@doktor.DoktorAd @doktor.DoktorSoyad</option>
            }
        </select>
    </div>

    <div class="mb-3" id="psikologSeciciAlani">
        <label class="form-label">Bağlı Psikolog</label>
        <select name="PsikologID" class="form-select">
            <option value="">Yok</option>
            @foreach (var psikolog in psikologlar)
            {
                <option value="@psikolog.PsikologID">@psikolog.PsikologAd @psikolog.PsikologSoyad</option>
            }
        </select>
    </div>

    <button type="submit" class="btn btn-primary">Oluştur</button>
    <a asp-action="Index" class="btn btn-secondary">İptal</a>
</form>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            var rolSelect = document.querySelector('select[name="RolID"]');
            var doktorDiv = document.getElementById('doktorSeciciAlani');
            var psikologDiv = document.getElementById('psikologSeciciAlani');

            function guncelle() {
                var rol = rolSelect.value;
                doktorDiv.style.display = (rol === '2') ? 'block' : 'none';
                psikologDiv.style.display = (rol === '4') ? 'block' : 'none';

                if (rol !== '2') document.querySelector('select[name="DoktorID"]').value = '';
                if (rol !== '4') document.querySelector('select[name="PsikologID"]').value = '';
            }

            rolSelect.addEventListener('change', guncelle);
            guncelle();
        });
    </script>
}