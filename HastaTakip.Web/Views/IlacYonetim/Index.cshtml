@model List<HastaTakip.Entities.Ilac>

@{
    ViewData["Title"] = "İlaç Yönetimi";
}

<h2>İlaç Yönetimi</h2>

@if (TempData["BasariMesaji"] != null)
{
    <div class="alert alert-success">@TempData["BasariMesaji"]</div>
}
@if (TempData["HataMesaji"] != null)
{
    <div class="alert alert-danger">@TempData["HataMesaji"]</div>
}

<a asp-action="Ekle" class="btn btn-primary mb-3">Yeni İlaç Ekle</a>

<!-- Arama ve Filtreleme -->
<form asp-action="Index" method="get" class="row g-3 mb-4">
    <!-- Arama -->
    <div class="col-md-3">
        <label class="form-label">Arama Kutusu</label>
        <input type="text"
               name="ara"
               value="@ViewBag.Ara"
               class="form-control"
               placeholder="İlaç adi veya etken madde" />
    </div>
    <!-- Butonlar -->
    <div class="col-md-2 d-grid">
        <button type="submit" class="btn btn-primary">
            Filtrele
        </button>
    </div>

    <div class="col-md-2 d-grid">
        <a asp-action="Index" class="btn btn-secondary">
            Temizle
        </a>
    </div>
</form>


<table class="table table-striped">
    <thead>
        <tr><th>İlaç Adı</th><th>İlaç Etken Madde</th><th>İşlemler</th></tr>
    </thead>
    <tbody>
        @foreach (var ilac in Model)
        {
            <tr>
                <td>@ilac.IlacAdi</td>
                <td>@ilac.IlacEtkenMadde</td>
                <td>
                    <form asp-action="Sil" method="post" class="d-inline">
                        <input type="hidden" name="ilacID" value="@ilac.IlacID" />
                        <button type="submit" class="btn btn-sm btn-danger"
                                onclick="return confirm('Bu ilacı silmek istediğinize emin misiniz?');">
                            Sil
                        </button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var aramaKutusu = document.querySelector('input[name="ara"]');
            var form = aramaKutusu.closest('form');
            var zamanlayici;

            // Sayfa yeniden yüklendiğinde, daha önce arama yapılıyorduysa kutuya odaklan
            if (aramaKutusu.value) {
                aramaKutusu.focus();
                // İmleci metnin sonuna koy (başına değil)
                var deger = aramaKutusu.value;
                aramaKutusu.value = '';
                aramaKutusu.value = deger;
            }

            aramaKutusu.addEventListener('input', function () {
                clearTimeout(zamanlayici);
                zamanlayici = setTimeout(function () {
                    form.submit();
                }, 400);
            });
        });
    </script>
}