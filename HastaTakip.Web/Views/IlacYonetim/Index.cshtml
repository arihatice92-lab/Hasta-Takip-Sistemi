@model List<HastaTakip.Entities.Ilac>

@{
    ViewData["Title"] = "İlaç Yönetimi";
}

<h2>İlaç Yönetimi</h2>

@if (TempData["BasariMesaji"] != null)
{
    <div class="alert alert-success">@TempData["BasariMesaji"]</div>
}
@if (TempData["HataMesaji"] != null)
{
    <div class="alert alert-danger">@TempData["HataMesaji"]</div>
}

<a asp-action="Ekle" class="btn btn-primary mb-3">Yeni İlaç Ekle</a>

<!-- Arama ve Filtreleme -->
<form asp-action="Index" method="get" class="row g-3 mb-4">
    <!-- Arama -->
    <div class="col-md-3">
        <label class="form-label">Arama Kutusu</label>
        <input type="text"
               name="ara"
               value="@ViewBag.Ara"
               class="form-control"
               placeholder="İlaç adi veya etken madde" />
    </div>

    <div class="col-md-2">
        <label class="form-label">Durum</label>
        <select name="aktif" class="form-select" onchange="this.form.submit()">
            <option value="hepsi" selected="@(ViewBag.Aktif == "hepsi")">Tümü</option>
            <option value="aktif" selected="@(ViewBag.Aktif == "aktif")">Aktif</option>
            <option value="pasif" selected="@(ViewBag.Aktif == "pasif")">Pasif</option>
        </select>
    </div>
    <!-- Butonlar -->
    <div class="col-md-2 d-flex align-items-end gap-2">
        <button type="submit" class="btn btn-primary w-100">
            Filtrele
        </button>
    </div>

    <div class="col-md-2 d-flex align-items-end">
        <a asp-action="Index" class="btn btn-secondary w-100">
            Temizle
        </a>
    </div>
</form>


<table class="table table-striped align-middle">
    <thead>
        <tr><th style="width: 30%">İlaç Adı</th><th style="width: 30%">İlaç Etken Madde</th><th style="width: 20%">Durum</th><th style="width: 20%">İşlemler</th></tr>
    </thead>
    <tbody>
        @foreach (var ilac in Model)
        {
            <tr>
                <td>@ilac.IlacAdi</td>
                <td>@ilac.IlacEtkenMadde</td>
                <td>
                    @if (ilac.IlacAktif)
                    {
                        <span class="badge bg-success">Aktif</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">Pasif</span>
                    }
                </td>
                <td>
                    <a asp-action="Guncelle" asp-route-ilacID="@ilac.IlacID" class="btn btn-sm btn-warning">Düzenle</a>
                    @if (ilac.IlacAktif)
                    {
                        <form asp-action="PasifeAl" method="post" class="d-inline">
                            <input type="hidden" name="ilacID" value="@ilac.IlacID" />
                            <button type="submit" class="btn btn-sm btn-secondary">Pasife Al</button>
                        </form>
                    }
                    else
                    {
                        <form asp-action="AktifEt" method="post" class="d-inline">
                            <input type="hidden" name="ilacID" value="@ilac.IlacID" />
                            <button type="submit" class="btn btn-sm btn-success">Aktife Al</button>
                        </form>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var aramaKutusu = document.querySelector('input[name="ara"]');
            var form = aramaKutusu.closest('form');
            var zamanlayici;

            // Sayfa yeniden yüklendiğinde, daha önce arama yapılıyorduysa kutuya odaklan
            if (aramaKutusu.value) {
                aramaKutusu.focus();
                // İmleci metnin sonuna koy (başına değil)
                var deger = aramaKutusu.value;
                aramaKutusu.value = '';
                aramaKutusu.value = deger;
            }

            aramaKutusu.addEventListener('input', function () {
                clearTimeout(zamanlayici);
                zamanlayici = setTimeout(function () {
                    form.submit();
                }, 400);
            });
        });
    </script>
}