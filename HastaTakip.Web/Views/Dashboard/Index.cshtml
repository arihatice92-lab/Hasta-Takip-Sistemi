@{
    ViewData["Title"] = "Ana Sayfa";
}

<h2>Hoş geldiniz, @User.FindFirst("AdSoyad")?.Value</h2>
<p class="text-muted">Hasta Takip Sistemi ana menüsü</p>

<div class="row mt-4">
    <div class="col-md-4 mb-3">
        <div class="card h-100">
            <div class="card-body">
                <h5 class="card-title">Hasta Yönetimi</h5>
                <p class="card-text">Hasta kaydı oluşturun, listeleyin ve detaylarını görüntüleyin.</p>
                <a asp-controller="Hasta" asp-action="Index" class="btn btn-primary">Hasta Listesi</a>
                @if (User.IsInRole("Yönetici") || User.IsInRole("Sekreter") || User.IsInRole("Doktor"))
                {
                    <a asp-controller="Hasta" asp-action="Ekle" class="btn btn-outline-primary">Yeni Hasta</a>            
                }
            </div>
        </div>
    </div>

    @if (User.IsInRole("Yönetici") || User.IsInRole("Sekreter"))
    {
        <div class="col-md-4 mb-3">
            <div class="card h-100">
                <div class="card-body">
                    <h5 class="card-title">Doktor Yönetimi</h5>
                    <p class="card-text">Doktor kaydı oluşturun, listeleyin ve bilgilerini güncelleyin.</p>
                    <a asp-controller="Doktor" asp-action="Index" class="btn btn-primary">Doktor Listesi</a>
                    <a asp-controller="Doktor" asp-action="Ekle" class="btn btn-outline-primary">Yeni Doktor</a>
                </div>
            </div>
        </div>
    }
    @if (User.IsInRole("Yönetici") || User.IsInRole("Sekreter"))
    {
        <div class="col-md-4 mb-3">
            <div class="card h-100">
                <div class="card-body">
                    <h5 class="card-title">Psikolog Yönetimi</h5>
                    <p class="card-text">Psikolog kaydı oluşturun, listeleyin ve bilgilerini güncelleyin.</p>
                    <a asp-controller="Psikolog" asp-action="Index" class="btn btn-primary">Psikolog Listesi</a>
                    <a asp-controller="Psikolog" asp-action="Ekle" class="btn btn-outline-primary">Yeni Psikolog</a>
                </div>
            </div>
        </div>
    }
    <div class="col-md-4 mb-3">
        <div class="card h-100">
            <div class="card-body">
                <h5 class="card-title">Doktor Randevuları</h5>
                <p class="card-text">Randevu oluşturun, listeleyin ve durumlarını yönetin.</p>
                <a asp-controller="Randevu" asp-action="Index" class="btn btn-primary">Randevu Listesi</a>
                <a asp-controller="Randevu" asp-action="Ekle" class="btn btn-outline-primary">Yeni Randevu</a>
            </div>
        </div>
    </div>
    <div class="col-md-4 mb-3">
        <div class="card h-100">
            <div class="card-body">
                <h5 class="card-title">Psikolog Randevuları</h5>
                <p class="card-text">Psikolog randevuları oluşturun ve yönetin.</p>
                <a asp-controller="PsikologRandevu" asp-action="Index" class="btn btn-primary">Randevu Listesi</a>
                <a asp-controller="PsikologRandevu" asp-action="Ekle" class="btn btn-outline-primary">Yeni Randevu</a>
            </div>
        </div>
    </div>
    @if (User.IsInRole("Yönetici") || User.IsInRole("Sekreter"))
    {
        <div class="col-md-4 mb-3">
            <div class="card h-100">
                <div class="card-body">
                    <h5 class="card-title">Test Yönetimi</h5>
                    <p class="card-text">Test kaydı oluşturun, listeleyin ve bilgilerini güncelleyin.</p>
                    <a asp-controller="TestYonetim" asp-action="Index" class="btn btn-primary">Test Listesi</a>
                    <a asp-controller="TestYonetim" asp-action="Ekle" class="btn btn-outline-primary">Yeni Test</a>
                </div>
            </div>
        </div>
    }
    @if (User.IsInRole("Yönetici") || User.IsInRole("Sekreter"))
    {
        <div class="col-md-4 mb-3">
            <div class="card h-100">
                <div class="card-body">
                    <h5 class="card-title">Ölçek Yönetimi</h5>
                    <p class="card-text">Ölçek kaydı oluşturun, listeleyin ve bilgilerini güncelleyin.</p>
                    <a asp-controller="OlcekYonetim" asp-action="Index" class="btn btn-primary">Ölçek Listesi</a>
                    <a asp-controller="OlcekYonetim" asp-action="Ekle" class="btn btn-outline-primary">Yeni Ölçek</a>
                </div>
            </div>
        </div>
    }
    @if (User.IsInRole("Yönetici") || User.IsInRole("Sekreter"))
    {
        <div class="col-md-4 mb-3">
            <div class="card h-100">
                <div class="card-body">
                    <h5 class="card-title">Tanı Yönetimi</h5>
                    <p class="card-text">Tanı kaydı oluşturun, listeleyin ve bilgilerini güncelleyin.</p>
                    <a asp-controller="TaniYonetim" asp-action="Index" class="btn btn-primary">Tanı Listesi</a>
                    <a asp-controller="TaniYonetim" asp-action="Ekle" class="btn btn-outline-primary">Yeni Tanı</a>
                </div>
            </div>
        </div>
    }
    @if (User.IsInRole("Yönetici") || User.IsInRole("Sekreter"))
    {
        <div class="col-md-4 mb-3">
            <div class="card h-100">
                <div class="card-body">
                    <h5 class="card-title">İlaç Yönetimi</h5>
                    <p class="card-text">İlaç kaydı oluşturun ve listeleyin.</p>
                    <a asp-controller="IlacYonetim" asp-action="Index" class="btn btn-primary">İlaç Listesi</a>
                    <a asp-controller="IlacYonetim" asp-action="Ekle" class="btn btn-outline-primary">Yeni İlaç</a>
                </div>
            </div>
        </div>
    }
    <div class="col-md-4 mb-3">
        <div class="card h-100">
            <div class="card-body">
                <h5 class="card-title">Aile / Gelişim Öyküsü</h5>
                <p class="card-text">TC girip doğrudan hastanın Aile/Gelişim sekmesine gidin.</p>
                <form asp-controller="Hasta" asp-action="Detay" method="get">
                    <input type="hidden" name="tab" value="aileGelisim" />
                    <div class="input-group">
                        <input type="text" name="tc" maxlength="11" class="form-control" placeholder="TC Kimlik No" required />
                        <button type="submit" class="btn btn-primary">Git</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>