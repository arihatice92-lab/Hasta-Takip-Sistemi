@model List<HastaTakip.Entities.Hasta>

@{
    ViewData["Title"] = "Hasta Listesi";
}
@if (TempData["Basari"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Basari"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
<h2>Hasta Listesi</h2>

<p>
    @if (User.IsInRole("Yönetici") || User.IsInRole("Sekreter") || User.IsInRole("Doktor"))
    {
        <a asp-action="Ekle" class="btn btn-primary">Yeni Hasta Ekle</a>
    }
</p>

<!-- Arama ve Filtreleme -->
<form asp-action="Index" method="get" class="row g-3 mb-4">

    <!-- Arama -->
    <div class="col-md-3">
        <label class="form-label">Arama Kutusu</label>
        <input type="text"
               name="ara"
               value="@ViewBag.Ara"
               class="form-control"
               placeholder="Dosya No, TC, Ad, Soyad..." />
    </div>



    <!-- Cinsiyet -->
    <div class="col-md-2">
        <label class="form-label">Cinsiyet</label>
        <select name="cinsiyet" class="form-select">
            <option value="">Hepsi</option>
            <option value="Kadın" selected="@(ViewBag.Cinsiyet == "Kadın")">Kadın</option>
            <option value="Erkek" selected="@(ViewBag.Cinsiyet == "Erkek")">Erkek</option>
        </select>
    </div>

    <!-- Başlangıç -->
    <div class="col-md-2">
        <label class="form-label">Başvuru Başlangıç Tarihi</label>
        <input type="date"
               name="baslangicTarihi"
               value="@(ViewBag.Baslangic?.ToString("yyyy-MM-dd"))"
               class="form-control" />
    </div>

    <!-- Bitiş -->
    <div class="col-md-2">
        <label class="form-label">Başvuru Bitiş Tarihi</label>
        <input type="date"
               name="bitisTarihi"
               value="@(ViewBag.Bitis?.ToString("yyyy-MM-dd"))"
               class="form-control" />
    </div>
    <!-- Durum -->
    <div class="col-md-2">
        <label class="form-label">Durum</label>
        <select name="aktif" class="form-select">
            <option value="hepsi" selected="@(ViewBag.Aktif == "hepsi")">Tümü</option>
            <option value="aktif" selected="@(ViewBag.Aktif == "aktif")">Aktif</option>
            <option value="pasif" selected="@(ViewBag.Aktif == "pasif")">Pasif</option>
        </select>
    </div>
    <!-- Sıralama -->
    <div class="col-md-3">
        <select name="siralama" class="form-select">
            <option value="AdAZ">Ada Göre (A-Z)</option>
            <option value="AdZA">Ada Göre (Z-A)</option>
            <option value="DosyaNo">Dosya No</option>
            <option value="Yeni">En Yeni Başvuru</option>
            <option value="Eski">En Eski Başvuru</option>
        </select>
    </div>

    <!-- Butonlar -->
    <div class="col-md-2 d-grid">
        <button type="submit" class="btn btn-primary">
            Filtrele
        </button>
    </div>

    <div class="col-md-2 d-grid">
        <a asp-action="Index" class="btn btn-secondary">
            Temizle
        </a>
    </div>

</form>


<table class="table table-striped">
    <thead>
        <tr>
            <th>Dosya No</th>
            <th>TC</th>
            <th>Ad Soyad</th>
            <th>Cinsiyet</th>
            <th>Doğum Tarihi</th>
            <th>Telefon</th>
            <th>Başvuru Tarihi</th>
            <th>Durum</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var hasta in Model)
        {
            var detayUrl = Url.Action("Detay", "Hasta", new { hastaGuid = hasta.HastaGuid });

            <tr class="hasta-satiri", data-href="@detayUrl" >
                <td>@hasta.HastaDosyaNo</td>
                <td>@hasta.HastaTC</td>
                <td>@hasta.HastaAd @hasta.HastaSoyad</td>
                <td>@hasta.HastaCinsiyet</td>
                <td>@hasta.HastaDogumTarihi.ToString("dd.MM.yyyy")</td>
                <td>@hasta.HastaTel</td>
                <td>@hasta.HastaBasvuruTarihi.ToString("dd.MM.yyyy")</td>
                <td>
                    @if (hasta.HastaAktif)
                    {
                        <span class="badge bg-success">Aktif</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">Pasif</span>
                    }
                </td>
                <td>
                    <a asp-action="Detay" asp-route-hastaGuid="@hasta.HastaGuid" class="btn btn-sm btn-info">Detay</a>
                </td>
            </tr>
        }
    </tbody>
</table>
@if (ViewBag.ToplamSayfa > 1)
{
    <nav>
        <ul class="pagination">
            @for (int i = 1; i <= ViewBag.ToplamSayfa; i++)
            {
                <li class="page-item @(i == ViewBag.SayfaNo ? "active" : "")">
                    <a class="page-link"
                       asp-action="Index"
                       asp-route-ara="@ViewBag.Ara"
                       asp-route-siralama="@ViewBag.Siralama"
                       asp-route-aktif="@ViewBag.Aktif"
                       asp-route-cinsiyet="@ViewBag.Cinsiyet"
                       asp-route-baslangicTarihi="@ViewBag.Baslangic"
                       asp-route-bitisTarihi="@ViewBag.Bitis"
                       asp-route-sayfa="@i">
                        @i
                    </a>
                </li>
            }
        </ul>
    </nav>
}
 <script>
    setTimeout(function() {
        var alert = document.querySelector('.alert');
        if (alert) {
            alert.classList.remove('show');
            alert.classList.add('fade');
            setTimeout(() => alert.remove(), 300);
        }
    }, 4000);
</script>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var aramaKutusu = document.querySelector('input[name="ara"]');
            var form = aramaKutusu.closest('form');
            var zamanlayici;

            if (aramaKutusu.value) {
                aramaKutusu.focus();
                var deger = aramaKutusu.value;
                aramaKutusu.value = '';
                aramaKutusu.value = deger;
            }

            aramaKutusu.addEventListener('input', function () {
                clearTimeout(zamanlayici);
                zamanlayici = setTimeout(function () {
                    form.submit();
                }, 400);
            });

                document.querySelectorAll('.hasta-satiri').forEach(function (satir) {
                        satir.style.cursor = 'pointer';
                        satir.addEventListener('click', function (e) {
                            if (e.target.closest('a, button, form, input, select')) {
                                return;
                            }
                            window.location = satir.dataset.href;
                        });
                    });
                });
    </script>
}