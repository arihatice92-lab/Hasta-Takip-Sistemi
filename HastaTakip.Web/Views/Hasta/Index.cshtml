@model List<HastaTakip.Entities.Hasta>

@{
    ViewData["Title"] = "Hasta Listesi";
}
@if (TempData["Basari"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Basari"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
<h2>Hasta Listesi</h2>

<p>
    <a asp-action="Ekle" class="btn btn-primary">Yeni Hasta Ekle</a>
</p>

<!-- Arama ve Filtreleme -->
<form asp-action="Index" method="get" class="row g-3 mb-4">

    <!-- Arama -->
    <div class="col-md-3">
        <label class="form-label">Arama Kutusu</label>
        <input type="text"
               name="ara"
               value="@ViewBag.Ara"
               class="form-control"
               placeholder="Dosya No, TC, Ad, Soyad..." />
    </div>

    <!-- Durum -->
    <div class="col-md-2">
        <label class="form-label">Durum (Hepsi)</label>
        <select name="aktif" class="form-select">
            @* <option value="">Durum (Hepsi)</option> *@
            <option value="true" selected="@(ViewBag.Aktif?.ToString() == "True")">Aktif</option>
            <option value="false" selected="@(ViewBag.Aktif?.ToString() == "False")">Pasif</option>
        </select>
    </div>

    <!-- Cinsiyet -->
    <div class="col-md-2">
        <label class="form-label">Cinsiyet</label>
        <select name="cinsiyet" class="form-select">
            <option value="">Hepsi</option>
            <option value="Kadın" selected="@(ViewBag.Cinsiyet == "Kadın")">Kadın</option>
            <option value="Erkek" selected="@(ViewBag.Cinsiyet == "Erkek")">Erkek</option>
        </select>
    </div>

    <!-- Başlangıç -->
    <div class="col-md-2">
        <label class="form-label">Başvuru Başlangıç Tarihi</label>
        <input type="date"
               name="baslangicTarihi"
               value="@(ViewBag.Baslangic?.ToString("yyyy-MM-dd"))"
               class="form-control" />
    </div>

    <!-- Bitiş -->
    <div class="col-md-2">
        <label class="form-label">Başvuru Bitiş Tarihi</label>
        <input type="date"
               name="bitisTarihi"
               value="@(ViewBag.Bitis?.ToString("yyyy-MM-dd"))"
               class="form-control" />
    </div>

    <!-- Sıralama -->
    <div class="col-md-3">
        <select name="siralama" class="form-select">
            <option value="AdAZ">Ada Göre (A-Z)</option>
            <option value="AdZA">Ada Göre (Z-A)</option>
            <option value="DosyaNo">Dosya No</option>
            <option value="Yeni">En Yeni Başvuru</option>
            <option value="Eski">En Eski Başvuru</option>
        </select>
    </div>

    <!-- Butonlar -->
    <div class="col-md-2 d-grid">
        <button type="submit" class="btn btn-primary">
            Filtrele
        </button>
    </div>

    <div class="col-md-2 d-grid">
        <a asp-action="Index" class="btn btn-secondary">
            Temizle
        </a>
    </div>

</form>


<table class="table table-striped">
    <thead>
        <tr>
            <th>Dosya No</th>
            <th>Ad Soyad</th>
            <th>TC</th>
            <th>Telefon</th>
            <th>Doğum Tarihi</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var hasta in Model)
        {
            <tr>
                <td>@hasta.HastaDosyaNo</td>
                <td>@hasta.HastaAd @hasta.HastaSoyad</td>
                <td>@hasta.HastaTC</td>
                <td>@hasta.HastaTel</td>
                <td>@hasta.HastaDogumTarihi.ToString("dd.MM.yyyy")</td>
                <td>
                    <a asp-action="Detay" asp-route-tc="@hasta.HastaTC" class="btn btn-sm btn-info">Detay</a>
                </td>
            </tr>
        }
    </tbody>
</table>

 <script>
    setTimeout(function() {
        var alert = document.querySelector('.alert');
        if (alert) {
            alert.classList.remove('show');
            alert.classList.add('fade');
            setTimeout(() => alert.remove(), 300);
        }
    }, 4000);
</script>