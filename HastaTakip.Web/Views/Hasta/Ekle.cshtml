@model HastaTakip.Entities.Hasta

@{
    ViewData["Title"] = "Yeni Hasta Ekle";
}

<h2>Yeni Hasta Ekle</h2>

<div asp-validation-summary="ModelOnly" class="text-danger"></div> @*All yerine ModelOnly yazdık ki hata mesajları kutunun hemen altında yer alsın. All yazdığında sayfanın başında oluyor.*@

<form asp-action="Ekle" method="post">
    <div class="row">
    <div class="col-md-4">
        <label asp-for="HastaTC" class="form-label">TC Kimlik No  <span style="color:red">*</span></label>
        <input asp-for="HastaTC" class="form-control" maxlength="11" />
        <span asp-validation-for="HastaTC" class="text-danger"></span>
    </div>

    <div class="col-md-4">
        <label asp-for="HastaAd" class="form-label">Ad <span style="color:red">*</span></label>
        <input asp-for="HastaAd" class="form-control" />
        <span asp-validation-for="HastaAd" class="text-danger"></span>
    </div>

    <div class="col-md-4">
        <label asp-for="HastaSoyad" class="form-label">Soyad <span style="color:red">*</span></label>
        <input asp-for="HastaSoyad" class="form-control" />
        <span asp-validation-for="HastaSoyad" class="text-danger"></span>
    </div>

    <div class="col-md-4">
        <label asp-for="HastaCinsiyet" class="form-label">Cinsiyet <span style="color:red">*</span></label>
        <select asp-for="HastaCinsiyet" class="form-control">
            <option value="">Seçiniz</option>
            <option value="Erkek">Erkek</option>
            <option value="Kadın">Kadın</option>
        </select>
        <span asp-validation-for="HastaCinsiyet" class="text-danger"></span>
    </div>

    <div class="col-md-4">
        <label asp-for="HastaDogumTarihi" class="form-label">Doğum Tarihi <span style="color:red">*</span></label>
        <input asp-for="HastaDogumTarihi" type="date" class="form-control" />
        <span asp-validation-for="HastaDogumTarihi" class="text-danger"></span>
    </div>
        <div class="col-md-4">
            <label asp-for="HastaTel" class="form-label">Telefon <span style="color:red">*</span></label>
            <input asp-for="HastaTel" class="form-control" maxlength="11" />
            <span asp-validation-for="HastaTel" class="text-danger"></span>
        </div>

        <div class="col-md-12">
            <label asp-for="HastaAdres" class="form-label">Adres <span style="color:red">*</span></label>
            <textarea asp-for="HastaAdres" class="form-control"></textarea>
            <span asp-validation-for="HastaAdres" class="text-danger"></span>
        </div>
    <div class="col-md-6">
        <label asp-for="HastaOkul" class="form-label">Okul <span style="color:red">*</span></label>
        <input asp-for="HastaOkul" class="form-control" />
        <span asp-validation-for="HastaOkul" class="text-danger"></span>
    </div>

    <div class="col-md-3">
        <label asp-for="HastaSinif" class="form-label">Sınıf</label>
        <input asp-for="HastaSinif" type="number" min="0" max="12" class="form-control" />
    </div>

    <div class="col-md-3">
        <label asp-for="HastaOkulBasarisi" class="form-label">Okul Başarısı <span style="color:red">*</span></label>
        <select asp-for="HastaOkulBasarisi" class="form-control">
            <option value="">Seçiniz</option>
            <option value="Düşük">Düşük</option>
            <option value="Orta">Orta</option>
            <option value="Yüksek">Yüksek</option>
        </select>
        <span asp-validation-for="HastaOkulBasarisi" class="text-danger"></span>
    </div>

    <div class="col-md-3">
        <label asp-for="HastaBoy" class="form-label">Boy (cm)</label>
        <input asp-for="HastaBoy" type="number" class="form-control" />
    </div>

    <div class="col-md-3">
        <label asp-for="HastaKilo" class="form-label">Kilo (kg)</label>
        <input asp-for="HastaKilo" type="number" class="form-control" />
    </div>

    <div class="col-md-6">
        <label asp-for="HastaYonlendiren" class="form-label">Yönlendiren <span style="color:red">*</span></label>
        <input asp-for="HastaYonlendiren" class="form-control" />
        <span asp-validation-for="HastaYonlendiren" class="text-danger"></span>
    </div>

    <div class="col-md-12">
        <label asp-for="HastaBasvuruNedeni" class="form-label">Başvuru Nedeni <span style="color:red">*</span></label>
        <textarea asp-for="HastaBasvuruNedeni" class="form-control"></textarea>
        <span asp-validation-for="HastaBasvuruNedeni" class="text-danger"></span>
    </div>
    </div>

    <button type="submit" class="btn btn-primary">Kaydet</button>
    <a asp-action="Index" class="btn btn-secondary">İptal</a>
</form>