@model HastaTakip.Entities.Hasta

@{
    ViewData["Title"] = "Hasta Detayı";
}
@{
    var dogum = Model.HastaDogumTarihi.Date;
    var bugun = DateTime.Today;

    int yasYil = bugun.Year - dogum.Year;
    int yasAy = bugun.Month - dogum.Month;

    if (bugun.Day < dogum.Day)
    {
        yasAy--;
    }
    if (yasAy < 0)
    {
        yasYil--;
        yasAy += 12;
    }

    var yasMetni = yasYil > 0
        ? $"{yasYil} yıl {yasAy} ay"
        : $"{yasAy} ay";
}


<h2>@Model.HastaAd @Model.HastaSoyad <small class="text-muted">(@Model.HastaCinsiyet, @yasMetni)</small></h2>

@if (TempData["BasariMesaji"] != null)
{
    <div class="alert alert-success">@TempData["BasariMesaji"]</div>
}
@if (TempData["HataMesaji"] != null)
{
    <div class="alert alert-danger">@TempData["HataMesaji"]</div>
}

<ul class="nav nav-tabs mb-3" role="tablist">
    <li class="nav-item">
        <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#genelBilgiler" type="button">
            Genel Bilgiler
        </button>
    </li>
    <li class="nav-item">
        <button class="nav-link" data-bs-toggle="tab" data-bs-target="#taniTedavi" type="button">
            Tanı / Tedavi
        </button>
    </li>
    <li class="nav-item">
        <button class="nav-link" data-bs-toggle="tab" data-bs-target="#testOlcek" type="button">
            Test / Ölçek
        </button>
    </li>
    <li class="nav-item">
        <button class="nav-link" data-bs-toggle="tab" data-bs-target="#aileGelisim" type="button">
            Aile / Gelişim
        </button>
    </li>
    <li class="nav-item">
        <button class="nav-link" data-bs-toggle="tab" data-bs-target="#gecmisRandevular" type="button">
            Randevular
        </button>
    </li>
    <li class="nav-item">
        <button class="nav-link" data-bs-toggle="tab" data-bs-target="#randevuNotlari" type="button">
            Randevu Notları
        </button>
    </li>
</ul>

<div class="tab-content">
    <div class="tab-pane fade show active" id="genelBilgiler">
        <dl class="row">
            <dt class="col-sm-3">Dosya No</dt>
            <dd class="col-sm-9">@Model.HastaDosyaNo</dd>

            <dt class="col-sm-3">TC Kimlik No</dt>
            <dd class="col-sm-9">@Model.HastaTC</dd>

            <dt class="col-sm-3">Telefon</dt>
            <dd class="col-sm-9">@Model.HastaTel</dd>

            <dt class="col-sm-3">Adres</dt>
            <dd class="col-sm-9">@Model.HastaAdres</dd>

            <dt class="col-sm-3">Cinsiyet</dt>
            <dd class="col-sm-9">@Model.HastaCinsiyet</dd>

            <dt class="col-sm-3">Doğum Tarihi</dt>
            <dd class="col-sm-9">@Model.HastaDogumTarihi.ToString("dd.MM.yyyy")</dd>

            <dt class="col-sm-3">Okul</dt>
            <dd class="col-sm-9">@Model.HastaOkul</dd>

            <dt class="col-sm-3">Sınıf</dt>
            <dd class="col-sm-9">@Model.HastaSinif</dd>

            <dt class="col-sm-3">Okul Başarısı</dt>
            <dd class="col-sm-9">@Model.HastaOkulBasarisi</dd>

            <dt class="col-sm-3">Boy / Kilo</dt>
            <dd class="col-sm-9">@Model.HastaBoy cm / @Model.HastaKilo kg</dd>

            <dt class="col-sm-3">Yönlendiren</dt>
            <dd class="col-sm-9">@Model.HastaYonlendiren</dd>

            <dt class="col-sm-3">Başvuru Nedeni</dt>
            <dd class="col-sm-9">@Model.HastaBasvuruNedeni</dd>

            <dt class="col-sm-3">Başvuru Tarihi</dt>
            <dd class="col-sm-9">@Model.HastaBasvuruTarihi.ToString("dd.MM.yyyy")</dd>

            <dt class="col-sm-3">Durum</dt>
            <dd class="col-sm-9">@(Model.HastaAktif ? "Aktif" : "Pasif")</dd>
        </dl>

        <a asp-action="Index" class="btn btn-secondary">Listeye Dön</a>
        @if (User.IsInRole("Yönetici") || User.IsInRole("Sekreter") || User.IsInRole("Doktor"))
        {
            <a asp-action="Guncelle" asp-route-tc="@Model.HastaTC" class="btn btn-warning">Düzenle</a>
        }
        <a asp-controller="Randevu" asp-action="Ekle" asp-route-hastaTC="@Model.HastaTC" class="btn btn-primary">Randevu Oluştur</a>
        
        @if (User.IsInRole("Yönetici") || User.IsInRole("Sekreter") || User.IsInRole("Doktor"))
        {
            @if (Model.HastaAktif)
            {
                <form asp-action="PasifeAl" method="post" class="d-inline">
                    <input type="hidden" name="tc" value="@Model.HastaTC" />
                    <button type="submit" class="btn btn-secondary"
                            onclick="return confirm('Bu hastayı pasife almak istediğinize emin misiniz? Hasta listede görünmeye devam etmez, kayıtları korunur.');">
                        Pasife Al
                    </button>
                </form>
            }
            else
            {
                <form asp-action="AktifEt" method="post" class="d-inline">
                    <input type="hidden" name="tc" value="@Model.HastaTC" />
                    <button type="submit" class="btn btn-success" onclick="return confirm('Bu hastayı aktife almak istediğinize emin misiniz?');">Aktife Al</button>
                </form>
            }
        }
        @if (User.IsInRole("Yönetici"))
        {
            <hr class="my-4" />
            <form asp-action="Sil" method="post"
                  onsubmit="return confirm('DİKKAT: Bu hasta ve TÜM ilişkili kayıtları (randevular, tanılar, tedaviler, test/ölçek sonuçları, aile bilgileri, gelişimsel öykü vb.) kalıcı olarak silinecektir. Bu işlem GERİ ALINAMAZ. Devam etmek istediğinize emin misiniz?');">
                <input type="hidden" name="tc" value="@Model.HastaTC" />
                <button type="submit" class="btn btn-link btn-sm text-danger p-0">
                    Bu hastayı tüm kayıtlarıyla kalıcı olarak sil
                </button>
            </form>
        }
    </div>

    <div class="tab-pane fade" id="taniTedavi">
        @{
            var tanilar = (List<HastaTakip.Entities.HastaTani>)ViewBag.Tanilar;
            var tedaviler = (List<HastaTakip.Entities.HastaTedavi>)ViewBag.Tedaviler;
            var taniSozlugu = (Dictionary<short, HastaTakip.Entities.Tani>)ViewBag.TaniSozlugu;
            var ilacSozlugu = (Dictionary<short, HastaTakip.Entities.Ilac>)ViewBag.IlacSozlugu;
            var doktorlarSozluk = (Dictionary<short, HastaTakip.Entities.Doktor>)ViewBag.Doktorlar;
        }

        <h5>Tanılar</h5>
        @if (User.IsInRole("Yönetici") || User.IsInRole("Doktor"))
        {
            <a asp-controller="Tani" asp-action="Ekle" asp-route-hastaTC="@Model.HastaTC" class="btn btn-sm btn-primary mb-2">Tanı Ekle</a>
        }

        @if (tanilar.Count == 0)
        {
            <p class="text-muted">Kayıtlı tanı bulunmuyor.</p>
        }
        else
        {
            <table class="table table-sm table-striped">
                <thead><tr><th>Tarih</th><th>Tanı Adı</th><th>Tanı Kodu</th><th>Doktor</th><th>Mental Durum Muayenesi</th><th>İşlemler</th></tr></thead>
                <tbody>
                    @foreach (var t in tanilar)
                    {
                        <tr>
                            <td>@t.TaniTarih.ToString("dd.MM.yyyy")</td>
                            <td>@(taniSozlugu.TryGetValue(t.TaniID, out var tani) ? tani.TaniAdi : "-")</td>
                            <td>@(taniSozlugu.TryGetValue(t.TaniID, out var taniKod) ? taniKod.TaniKodu : "-")</td>
                            <td>@(doktorlarSozluk.TryGetValue(t.DoktorID, out var d1) ? $"{d1.DoktorAd} {d1.DoktorSoyad}" : "-")</td>
                            <td>@(t.MentalDurumMuayenesi ?? "-")</td>
                            <td>
                                @if (User.IsInRole("Yönetici") || User.IsInRole("Doktor"))
                                {
                                    <a asp-controller="Tani" asp-action="Guncelle" asp-route-hastaTaniID="@t.HastaTaniID" class="btn btn-sm btn-warning">Düzenle</a>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }

        <hr />

        <h5>Tedaviler</h5>
        @if (User.IsInRole("Yönetici") || User.IsInRole("Doktor"))
        {
            <a asp-controller="Tedavi" asp-action="Ekle" asp-route-hastaTC="@Model.HastaTC" class="btn btn-sm btn-primary mb-2">Tedavi Ekle</a>
        }
        @if (tedaviler.Count == 0)
        {
            <p class="text-muted">Kayıtlı tedavi bulunmuyor.</p>
        }
        else
        {
            <table class="table table-sm table-striped">
                <thead><tr><th>İlaç</th><th>Doz</th><th>Başlangıç Tarihi</th><th>Bitiş Tarihi</th><th>Doktor</th><th>Yan Etkiler</th><th>Tedavi Notları</th><th>İşlemler</th></tr></thead>
                <tbody>
                    @foreach (var t in tedaviler)
                    {
                        <tr>
                            <td>@(ilacSozlugu.TryGetValue(t.IlacID, out var ilac) ? ilac.IlacAdi : "-")</td>
                            <td>@t.IlacDozu</td>
                            <td>@(t.IlacBaslangicTarihi?.ToString("dd.MM.yyyy") ?? "-")</td>
                            <td>@(t.IlacBitisTarihi?.ToString("dd.MM.yyyy") ?? "-")</td>
                            <td>@(doktorlarSozluk.TryGetValue(t.DoktorID, out var d2) ? $"{d2.DoktorAd} {d2.DoktorSoyad}" : "-")</td>
                            <td>@t.IlacYanEtkiler</td>
                            <td>@t.TedaviNotlari</td>
                            <td>
                                @if (User.IsInRole("Yönetici") || User.IsInRole("Doktor"))
                                {
                                    <a asp-controller="Tedavi" asp-action="Guncelle" asp-route-tedaviID="@t.TedaviID" class="btn btn-sm btn-warning">Düzenle</a>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>

    <div class="tab-pane fade" id="testOlcek">
    @{
        var testSonuclari = (List<HastaTakip.Entities.TestSonuc>)ViewBag.TestSonuclari;
        var olcekSonuclari = (List<HastaTakip.Entities.OlcekSonuc>)ViewBag.OlcekSonuclari;
        var testSozlugu = (Dictionary<byte, HastaTakip.Entities.Test>)ViewBag.TestSozlugu;
        var olcekSozlugu = (Dictionary<byte, HastaTakip.Entities.Olcek>)ViewBag.OlcekSozlugu;
        var psikologSozlugu = (Dictionary<byte, HastaTakip.Entities.Psikolog>)ViewBag.PsikologSozlugu;
        var altKumeSonuclariSozluk = (Dictionary<int, List<HastaTakip.Entities.AltKumeSonuc>>)ViewBag.AltKumeSonuclariSozluk;
        var altKumeAdSozlugu = (Dictionary<byte, HastaTakip.Entities.TestAltKume>)ViewBag.AltKumeAdSozlugu;
    }

    <h5>Test Sonuçları</h5>
    @if (User.IsInRole("Yönetici") || User.IsInRole("Psikolog"))
        {
            <a asp-controller="TestSonuc" asp-action="Ekle" asp-route-hastaTC="@Model.HastaTC" class="btn btn-sm btn-primary mb-2">Test Sonucu Ekle</a>
        }
        @if (testSonuclari.Count == 0)
    {
        <p class="text-muted">Kayıtlı test sonucu bulunmuyor.</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-sm table-striped">
                <thead>
                    <tr>
                        <th>Tarih</th>
                        <th>Test</th>
                        <th>Psikolog</th>
                        <th>Sonuç</th>
                        <th>Değerlendirme</th>
                        <th>İşlem</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var ts in testSonuclari)
                    {
                        <tr>
                            <td>@ts.TestTarih.ToString("dd.MM.yyyy")</td>
                            <td>@(testSozlugu.TryGetValue(ts.TestID, out var test) ? test.TestAdi : "-")</td>
                            <td>@(psikologSozlugu.TryGetValue(ts.PsikologID, out var psi) ? $"{psi.PsikologAd} {psi.PsikologSoyad}" : "-")</td>
                            <td>@(ts.SonucDegeri ?? "-")</td>
                            <td>@(ts.TestDegerlendirme ?? "-")</td>
                            <td>
                                    @if (User.IsInRole("Yönetici") || User.IsInRole("Psikolog"))
                                    {
                                        <a asp-controller="TestSonuc" asp-action="Guncelle" asp-route-testSonucID="@ts.TestSonucID" class="btn btn-sm btn-warning">Düzenle</a>
                                    }
                            </td>
                        </tr>

                            var altKumeler = altKumeSonuclariSozluk.TryGetValue(ts.TestSonucID, out var akList)
                                ? akList
                                : new List<HastaTakip.Entities.AltKumeSonuc>();
                        
                        @if (altKumeler.Count > 0)
                        {
                            <tr>
                                <td></td>
                                <td colspan="5">
                                    <table class="table table-sm table-bordered mb-0">
                                        <thead>
                                            <tr><th>Alt Küme</th><th>Sonuç</th><th>Yorum</th></tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var ak in altKumeler)
                                            {
                                                <tr>
                                                    <td>@(altKumeAdSozlugu.TryGetValue(ak.AltKumeID, out var akAd) ? akAd.TestAltKumeAdi : "-")</td>
                                                    <td>@(ak.AltKumeSonucDeger ?? "-")</td>
                                                    <td>@(ak.AltKumeYorum ?? "-")</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    }

    <hr />

    <h5>Ölçek Sonuçları</h5>
   
        @if (User.IsInRole("Yönetici") || User.IsInRole("Doktor"))
        {
            <a asp-controller="OlcekSonuc" asp-action="Ekle" asp-route-hastaTC="@Model.HastaTC" class="btn btn-sm btn-primary mb-2">Ölçek Sonucu Ekle</a>
        }

        @if (olcekSonuclari.Count == 0)
    {
        <p class="text-muted">Kayıtlı ölçek sonucu bulunmuyor.</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-sm table-striped">
                <thead>
                    <tr>
                        <th>Tarih</th>
                        <th>Ölçek</th>
                        <th>Doktor</th>
                        <th>Puan</th>
                        <th>Yorum</th>
                        <th>Uygulanan</th>
                        <th>İşlem</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var os in olcekSonuclari)
                    {
                        <tr>
                            <td>@os.OlcekTarih.ToString("dd.MM.yyyy")</td>
                            <td>@(olcekSozlugu.TryGetValue(os.OlcekID, out var olcek) ? olcek.OlcekAdi : "-")</td>
                            <td>@(doktorlarSozluk.TryGetValue(os.DoktorID, out var d3) ? $"{d3.DoktorAd} {d3.DoktorSoyad}" : "-")</td>
                            <td>@(os.OlcekPuan?.ToString() ?? "-")</td>
                            <td>@(os.OlcekYorum ?? "-")</td>
                            <td>@(os.OlcekUygulanan ?? "-")</td>
                            <td>
                                          @if (User.IsInRole("Yönetici") || User.IsInRole("Doktor"))
                                    {
                                        <a asp-controller="OlcekSonuc" asp-action="Guncelle" asp-route-olcekSonucID="@os.OlcekSonucID" class="btn btn-sm btn-warning">Düzenle</a>
                                    }
                                    
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
    
    <div class="tab-pane fade" id="aileGelisim">
        @{
            var aileBilgileriListesi = (List<HastaTakip.Entities.AileBilgileri>)ViewBag.AileBilgileriListesi;
            var aileOykusuListesi = (List<HastaTakip.Entities.AileOykusu>)ViewBag.AileOykusuListesi;
            var gelisimselOykuListesi = (List<HastaTakip.Entities.GelisimselOyku>)ViewBag.GelisimselOykuListesi;
            var kullanicilarSozluk = (Dictionary<int, HastaTakip.Entities.Kullanici>)ViewBag.Kullanicilar;
            var notlarSozlugu = (Dictionary<(string, int), List<HastaTakip.Entities.KayitNotu>>)ViewBag.NotlarSozlugu;

            string GuncelleyenBilgisi(int? kullaniciID, DateTime? tarih)
            {
                var isim = kullaniciID.HasValue && kullanicilarSozluk.TryGetValue(kullaniciID.Value, out var k) ? k.AdSoyad : "-";
                var tarihMetin = tarih?.ToString("dd.MM.yyyy HH:mm") ?? "-";
                return $"Son güncelleyen: {isim}, {tarihMetin}";
            }
        }

        <h5>Aile Bilgileri</h5>
        @if (User.IsInRole("Yönetici") || User.IsInRole("Doktor"))
        {
            <a asp-controller="AileBilgileri" asp-action="Ekle" asp-route-hastaTC="@Model.HastaTC" class="btn btn-sm btn-primary mb-2">Yeni Aile Bilgisi Ekle</a>
        }

        @if (aileBilgileriListesi.Count == 0)
        {
            <p class="text-muted">Kayıtlı aile bilgisi bulunmuyor.</p>
        }
        else
        {
            @foreach (var ab in aileBilgileriListesi)
            {
                var panelId = $"aileBilgi{ab.AileBilgileriID}";
                <div class="card mb-2">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center" style="cursor:pointer;"
                             data-bs-toggle="collapse" data-bs-target="#@panelId">
                            <div>
                                <strong>@ab.AnneAd @ab.AnneSoyad</strong> &amp; <strong>@ab.BabaAd @ab.BabaSoyad</strong>
                                <span class="text-muted small ms-2">(@(ab.AileTipi ?? "-"))</span>
                            </div>
                            <span class="text-muted small">@GuncelleyenBilgisi(ab.SonGuncelleyenKullaniciID, ab.SonGuncellemeTarihi)</span>
                        </div>

                        <div class="collapse mt-3" id="@panelId">
                            <dl class="row mb-2">
                                <dt class="col-sm-3">Anne</dt>
                                <dd class="col-sm-9">
                                    @ab.AnneAd @ab.AnneSoyad (@(ab.AnneYasiyorMu ? "Hayatta" : "Vefat")),
                                    Yaş: @(ab.AnneYas?.ToString() ?? "-"), Eğitim: @(ab.AnneEgitim ?? "-"),
                                    İş: @(ab.AnneIs ?? "-"), Tel: @(ab.AnneTel ?? "-"), Adres: @(ab.AnneAdres ?? "-")
                                </dd>

                                <dt class="col-sm-3">Baba</dt>
                                <dd class="col-sm-9">
                                    @ab.BabaAd @ab.BabaSoyad (@(ab.BabaYasiyorMu ? "Hayatta" : "Vefat")),
                                    Yaş: @(ab.BabaYas?.ToString() ?? "-"), Eğitim: @(ab.BabaEgitim ?? "-"),
                                    İş: @(ab.BabaIs ?? "-"), Tel: @(ab.BabaTel ?? "-"), Adres: @(ab.BabaAdres ?? "-")
                                </dd>

                                @if (ab.UveyVeyaKoruyucuVarMi)
                                {
                                    <dt class="col-sm-3">Üvey Ebeveyn/Koruyucu</dt>
                                    <dd class="col-sm-9">
                                        @ab.UveyAd @ab.UveySoyad (@(ab.UveyEbeveynTuru ?? "-")),
                                        Yaş: @(ab.UveyYas?.ToString() ?? "-"), Tel: @(ab.UveyTel ?? "-")
                                    </dd>
                                }

                                <dt class="col-sm-3">Akraba Evliliği</dt>
                                <dd class="col-sm-9">@(ab.AkrabaEvliligi ? "Var" : "Yok")</dd>

                                <dt class="col-sm-3">Ebeveyn Durumu</dt>
                                <dd class="col-sm-9">@(ab.EbeveynDurumu ?? "-")</dd>

                                <dt class="col-sm-3">Kardeşler</dt>
                                <dd class="col-sm-9">@(ab.Kardesler ?? "-")</dd>

                                <dt class="col-sm-3">Aile Psikiyatrik Öykü</dt>
                                <dd class="col-sm-9">@(ab.AilePsikiyatrikOyku ?? "-")</dd>

                                <dt class="col-sm-3">Aile Tıbbi Öykü</dt>
                                <dd class="col-sm-9">@(ab.AileTibbiOyku ?? "-")</dd>

                                <dt class="col-sm-3">Ek Notlar</dt>
                                <dd class="col-sm-9">@(ab.AileEkNotlar ?? "-")</dd>
                            </dl>
                            @{
                                var abNotlari = notlarSozlugu.TryGetValue(("AileBilgileri", ab.AileBilgileriID), out var abn) ? abn : new List<HastaTakip.Entities.KayitNotu>();
                                var abOlusturan = ab.OlusturanKullaniciID.HasValue && kullanicilarSozluk.TryGetValue(ab.OlusturanKullaniciID.Value, out var abk) ? abk.AdSoyad : "-";
                            }

                            <p class="text-muted small mb-1">İlk kaydeden: @abOlusturan, @(ab.OlusturmaTarihi?.ToString("dd.MM.yyyy HH:mm") ?? "-")</p>

                            <strong class="small">Ek Notlar</strong>
                            <ul class="small">
                                @foreach (var not in abNotlari)
                                {
                                    var isim = kullanicilarSozluk.TryGetValue(not.KullaniciID, out var k) ? k.AdSoyad : "-";
                                    <li>@not.NotMetni <span class="text-muted">(@isim, @not.NotTarihi.ToString("dd.MM.yyyy HH:mm"))</span></li>
                                }
                            </ul>

                            @if (User.IsInRole("Yönetici") || User.IsInRole("Doktor"))
                            {
                                <form asp-controller="KayitNotu" asp-action="Ekle" method="post" class="d-flex gap-2 mb-2">
                                    <input type="hidden" name="kayitTuru" value="AileBilgileri" />
                                    <input type="hidden" name="kayitID" value="@ab.AileBilgileriID" />
                                    <input type="hidden" name="hastaTC" value="@Model.HastaTC" />
                                    <input type="text" name="notMetni" class="form-control form-control-sm" placeholder="Yeni not..." required />
                                    <button type="submit" class="btn btn-sm btn-primary">Not Ekle</button>
                                </form>
                            }
                            @if (User.IsInRole("Yönetici") || User.IsInRole("Doktor") || User.IsInRole("Sekreter"))
                            {
                                <a asp-controller="AileBilgileri" asp-action="Guncelle" asp-route-aileBilgileriID="@ab.AileBilgileriID" class="btn btn-sm btn-warning">Düzenle</a>
                            }
                            
                        </div>
                    </div>
                </div>
            }
        }

        <hr />

        <h5>Aile Öyküsü</h5>
        @if (User.IsInRole("Yönetici") || User.IsInRole("Doktor"))
        {
            <a asp-controller="AileOykusu" asp-action="Ekle" asp-route-hastaTC="@Model.HastaTC" class="btn btn-sm btn-primary mb-2">Yeni Aile Öyküsü Ekle</a>
        }

        @if (aileOykusuListesi.Count == 0)
        {
            <p class="text-muted">Kayıtlı aile öyküsü bulunmuyor.</p>
        }
        else
        {
            @foreach (var ao in aileOykusuListesi)
            {
                var panelId = $"aileOyku{ao.AileOykuID}";
                <div class="card mb-2">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center" style="cursor:pointer;"
                             data-bs-toggle="collapse" data-bs-target="#@panelId">
                            <strong>Aile Öyküsü Kaydı</strong>
                            <span class="text-muted small">@GuncelleyenBilgisi(ao.SonGuncelleyenKullaniciID, ao.SonGuncellemeTarihi)</span>
                        </div>

                        <div class="collapse mt-3" id="@panelId">
                            <dl class="row mb-2">
                                <dt class="col-sm-3">Anne-Babanın Kişisel Öyküsü</dt>
                                <dd class="col-sm-9">@(ao.AnneBabaninKisiselOykusu ?? "-")</dd>

                                <dt class="col-sm-3">Anne-Babanın Evlilik Öyküsü</dt>
                                <dd class="col-sm-9">@(ao.AnneBabaninEvlilikOykusu ?? "-")</dd>

                                <dt class="col-sm-3">Aile Özellikleri</dt>
                                <dd class="col-sm-9">@(ao.AileOzellikleri ?? "-")</dd>

                                <dt class="col-sm-3">Anne-Baba Kardeşleri</dt>
                                <dd class="col-sm-9">@(ao.AnneBabaKardesler ?? "-")</dd>
                            </dl>
                            @if (User.IsInRole("Yönetici") || User.IsInRole("Doktor"))
                            {
                                <a asp-controller="AileOykusu" asp-action="Guncelle" asp-route-aileOykuID="@ao.AileOykuID" class="btn btn-sm btn-warning">Düzenle</a>
                            }
                        </div>
                    </div>
                </div>
            }
        }

        <hr />

        <h5>Gelişimsel Öykü</h5>
        @if (User.IsInRole("Yönetici") || User.IsInRole("Doktor"))
        {
            <a asp-controller="GelisimselOyku" asp-action="Ekle" asp-route-hastaTC="@Model.HastaTC" class="btn btn-sm btn-primary mb-2">Yeni Gelişimsel Öykü Ekle</a>
        }

        @if (gelisimselOykuListesi.Count == 0)
        {
            <p class="text-muted">Kayıtlı gelişimsel öykü bulunmuyor.</p>
        }
        else
        {
            @foreach (var go in gelisimselOykuListesi)
            {
                var panelId = $"gelisimOyku{go.GelisimOykuID}";
                <div class="card mb-2">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center" style="cursor:pointer;"
                             data-bs-toggle="collapse" data-bs-target="#@panelId">
                            <div>
                                <strong>Doğum Şekli:</strong> @(go.DogumSekli ?? "-")
                                <span class="text-muted small ms-2">Doğum Haftası: @(go.DogumHaftasi?.ToString() ?? "-")</span>
                            </div>
                            <span class="text-muted small">@GuncelleyenBilgisi(go.SonGuncelleyenKullaniciID, go.SonGuncellemeTarihi)</span>
                        </div>

                        <div class="collapse mt-3" id="@panelId">
                            <dl class="row mb-2">
                                <dt class="col-sm-3">Doğumda Anne/Baba Yaşı</dt>
                                <dd class="col-sm-9">Anne: @(go.DogumAnneYasi?.ToString() ?? "-"), Baba: @(go.DogumBabaYasi?.ToString() ?? "-")</dd>

                                <dt class="col-sm-3">Doğum Ağırlığı</dt>
                                <dd class="col-sm-9">@(go.DogumAgirligi?.ToString() ?? "-") gr</dd>

                                <dt class="col-sm-3">Doğum Komplikasyonu</dt>
                                <dd class="col-sm-9">@(go.DogumKomplikasyonu ?? "-")</dd>

                                <dt class="col-sm-3">Planlı Gebelik mi?</dt>
                                <dd class="col-sm-9">@(go.PlanliGebelikMi.HasValue ? (go.PlanliGebelikMi.Value ? "Evet" : "Hayır") : "-")</dd>

                                <dt class="col-sm-3">Gebe Kalmada Güçlük</dt>
                                <dd class="col-sm-9">@(go.GebeKalmadaGucluk ?? "-")</dd>

                                <dt class="col-sm-3">Ailenin Cinsiyet Beklentisi</dt>
                                <dd class="col-sm-9">@(go.AileCinsiyetBeklentisi ?? "-")</dd>

                                <dt class="col-sm-3">Ailenin Doğuma Tepkisi</dt>
                                <dd class="col-sm-9">@(go.AileDogumaTepki ?? "-")</dd>

                                <dt class="col-sm-3">Motor/Dil Gelişimi</dt>
                                <dd class="col-sm-9">
                                    Oturma: @(go.OturmaYasi?.ToString() ?? "-") ay,
                                    Emekleme: @(go.EmeklemeYasi?.ToString() ?? "-") ay,
                                    Yürüme: @(go.YurumeYasi?.ToString() ?? "-") ay,
                                    İlk Sözcük: @(go.IlkSozcukYasi?.ToString() ?? "-") ay,
                                    İlk Cümle: @(go.IlkCumleYasi?.ToString() ?? "-") ay
                                </dd>

                                <dt class="col-sm-3">Tuvalet Eğitimi</dt>
                                <dd class="col-sm-9">@(go.TuvaletEgitimi ?? "-")</dd>

                                <dt class="col-sm-3">Geçirilen Kaza</dt>
                                <dd class="col-sm-9">@(go.GecirilenKaza ?? "-")</dd>

                                <dt class="col-sm-3">Bebeklik Dönemi</dt>
                                <dd class="col-sm-9">@(go.BebeklikDonemi ?? "-")</dd>

                                <dt class="col-sm-3">Çocukluk Dönemi</dt>
                                <dd class="col-sm-9">@(go.CocuklukDonemi ?? "-")</dd>

                                <dt class="col-sm-3">Okul Öyküsü</dt>
                                <dd class="col-sm-9">@(go.OkulOykusu ?? "-")</dd>

                                <dt class="col-sm-3">Sosyal İlişkileri</dt>
                                <dd class="col-sm-9">@(go.SosyalIliskileri ?? "-")</dd>

                                <dt class="col-sm-3">Kişilik Özellikleri</dt>
                                <dd class="col-sm-9">@(go.KisilikOzellikleri ?? "-")</dd>

                                <dt class="col-sm-3">Ek Notlar</dt>
                                <dd class="col-sm-9">@(go.GelisimselOykuEkNot ?? "-")</dd>
                            </dl>
                            @{
                                var goNotlari = notlarSozlugu.TryGetValue(("GelisimselOyku", go.GelisimOykuID), out var gon) ? gon : new List<HastaTakip.Entities.KayitNotu>();
                                var goOlusturan = go.OlusturanKullaniciID.HasValue && kullanicilarSozluk.TryGetValue(go.OlusturanKullaniciID.Value, out var gok) ? gok.AdSoyad : "-";
                            }

                            <p class="text-muted small mb-1">İlk kaydeden: @goOlusturan, @(go.OlusturmaTarihi?.ToString("dd.MM.yyyy HH:mm") ?? "-")</p>

                            <strong class="small">Ek Notlar</strong>
                            <ul class="small">
                                @foreach (var not in goNotlari)
                                {
                                    var isim = kullanicilarSozluk.TryGetValue(not.KullaniciID, out var k) ? k.AdSoyad : "-";
                                    <li>@not.NotMetni <span class="text-muted">(@isim, @not.NotTarihi.ToString("dd.MM.yyyy HH:mm"))</span></li>
                                }
                            </ul>

                            @if (User.IsInRole("Yönetici") || User.IsInRole("Doktor"))
                            {
                                <form asp-controller="KayitNotu" asp-action="Ekle" method="post" class="d-flex gap-2 mb-2">
                                    <input type="hidden" name="kayitTuru" value="GelisimselOyku" />
                                    <input type="hidden" name="kayitID" value="@go.GelisimOykuID" />
                                    <input type="hidden" name="hastaTC" value="@Model.HastaTC" />
                                    <input type="text" name="notMetni" class="form-control form-control-sm" placeholder="Yeni not..." required />
                                    <button type="submit" class="btn btn-sm btn-primary">Not Ekle</button>
                                </form>
                            }
                            @if (User.IsInRole("Yönetici") || User.IsInRole("Doktor"))
                            {
                                <a asp-controller="GelisimselOyku" asp-action="Guncelle" asp-route-gelisimOykuID="@go.GelisimOykuID" class="btn btn-sm btn-warning">Düzenle</a>
                            }
                        </div>
                    </div>
                </div>
            }
        }
    </div>
    <div class="tab-pane fade" id="gecmisRandevular">
        @{
            var randevular = (List<HastaTakip.Entities.RandevuTarihi>)ViewBag.GecmisRandevular;
            var doktorlar = (Dictionary<short, HastaTakip.Entities.Doktor>)ViewBag.Doktorlar;
            var saatler = (Dictionary<byte, HastaTakip.Entities.RandevuSaat>)ViewBag.Saatler;
        }

        @if (randevular.Count == 0)
        {
            <p class="text-muted">Bu hastaya ait randevu kaydı bulunmuyor.</p>
        }
        else
        {
            <table class="table table-striped">
                <thead>
                    <tr>
                        <th style="width: 20%;">Tarih</th>
                        <th style="width: 15%;">Saat</th>
                        <th style="width: 40%;">Doktor</th>
                        <th style="width: 25%;">Durum</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var randevu in randevular)
                    {
                        <tr>
                            <td>@randevu.RandevuTarih.ToString("dd.MM.yyyy")</td>
                            <td>
                                @if (saatler.TryGetValue(randevu.SaatID, out var saat))
                                {
                                    @saat.RandevuBaslangicSaat.ToString(@"hh\:mm")
                                }
                            </td>
                            <td>
                                @if (doktorlar.TryGetValue(randevu.DoktorID, out var doktor))
                                {
                                    @($"{doktor.DoktorAd} {doktor.DoktorSoyad}")
                                }
                            </td>
                            <td>
                                @{
                                    var renk = randevu.RandevuDurum switch
                                    {
                                        "Tamamlandı" => "bg-success",
                                        "İptal" => "bg-secondary",
                                        "Gelmedi" => "bg-danger",
                                        _ => "bg-primary"
                                    };
                                }
                                <span class="badge @renk">@randevu.RandevuDurum</span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        <hr />
        <h5>Psikolog Randevuları</h5>
        @{
            var psikologRandevular = (List<HastaTakip.Entities.PsikologRandevuTarihi>)ViewBag.PsikologRandevular;
            
            var psikologSaatSozlugu = (Dictionary<byte, HastaTakip.Entities.PsikologRandevuSaat>)ViewBag.PsikologSaatSozlugu;
        }

        @if (psikologRandevular.Count == 0)
        {
            <p class="text-muted">Bu hastaya ait psikolog randevusu bulunmuyor.</p>
        }
        else
        {
            <table class="table table-striped">
                <thead><tr><th style="width: 20%;">Tarih</th><th style="width: 15%;">Saat</th><th style="width: 40%;">Psikolog</th><th style ="width: 25%;">Durum</th></tr></thead>
                <tbody>
                    @foreach (var pr in psikologRandevular)
                    {
                        <tr>
                            <td>@pr.RandevuTarih.ToString("dd.MM.yyyy")</td>
                            <td>@(psikologSaatSozlugu.TryGetValue(pr.SaatID, out var s) ? s.RandevuBaslangicSaat.ToString(@"hh\:mm") : "-")</td>
                            <td>@(psikologSozlugu.TryGetValue(pr.PsikologID, out var p) ? $"{p.PsikologAd} {p.PsikologSoyad}" : "-")</td>
                            @{
                                var prRenk = pr.RandevuDurum switch
                                {
                                    "Tamamlandı" => "bg-success",
                                    "İptal" => "bg-secondary",
                                    "Gelmedi" => "bg-danger",
                                    _ => "bg-primary"
                                };
                            }
                            <td><span class="badge @prRenk">@pr.RandevuDurum</span></td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
    <div class="tab-pane fade" id="randevuNotlari">
        @{
            var randevuNotlari = (List<HastaTakip.Entities.RandevuNotu>)ViewBag.RandevuNotlari;
            var randevuSozlugu = (Dictionary<int, HastaTakip.Entities.RandevuTarihi>)ViewBag.RandevuSozlugu;
        }

        @if (ViewBag.AktifRandevuTarihID != null)
        {
            <div class="alert alert-warning d-flex justify-content-between align-items-center">
                <span>Muayenesi başlatılan randevu için henüz not girilmedi.</span>
                @if (User.IsInRole("Yönetici") || User.IsInRole("Doktor"))
                {
                    <a asp-controller="RandevuNotu" asp-action="Ekle" asp-route-randevuTarihID="@ViewBag.AktifRandevuTarihID" class="btn btn-sm btn-primary">
                    Randevu Notu Ekle
                </a>
                }
            </div>
        }

        @if (User.IsInRole("Yönetici") || User.IsInRole("Doktor"))
        {
            <a asp-controller="Randevu" asp-action="Index" asp-route-hastaTC="@Model.HastaTC" class="btn btn-sm btn-primary mb-2">
                Randevu Notu Ekle
            </a>
        }

        @if (randevuNotlari.Count == 0)
        {
            <p class="text-muted">Bu hastaya ait randevu notu bulunmuyor.</p>
        }
        else
        {
            @foreach (var not in randevuNotlari)
            {
                var randevuVarMi = randevuSozlugu.TryGetValue(not.RandevuTarihID, out var randevu);
                var doktorAdi = doktorlarSozluk.TryGetValue(not.DoktorID, out var dNot) ? $"{dNot.DoktorAd} {dNot.DoktorSoyad}" : "-";
                var panelId = $"randevuNotu{not.RandevuNotID}";

                <div class="card mb-2">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center" style="cursor:pointer;"
                             data-bs-toggle="collapse" data-bs-target="#@panelId">
                            <div>
                                <strong>@(randevuVarMi ? randevu!.RandevuTarih.ToString("dd.MM.yyyy") : "-")</strong>
                                <span class="text-muted small ms-2">Doktor: @doktorAdi</span>
                            </div>
                            <span class="text-muted small">@(not.GorusmeTipi ?? "-")</span>
                        </div>

                        <div class="collapse mt-3" id="@panelId">
                            <dl class="row mb-2">
                                <dt class="col-sm-3">Görüşme Tipi</dt>
                                <dd class="col-sm-9">@(not.GorusmeTipi ?? "-")</dd>

                                <dt class="col-sm-3">Görüşme Notu</dt>
                                <dd class="col-sm-9">@(not.GorusmeNotu ?? "-")</dd>

                                <dt class="col-sm-3">Sonraki Randevu Tarihi</dt>
                                <dd class="col-sm-9">@(not.SonrakiRandevuTarihi?.ToString("dd.MM.yyyy") ?? "-")</dd>
                            </dl>

                            @if (User.IsInRole("Yönetici") || User.IsInRole("Doktor"))
                            {
                                <a asp-controller="RandevuNotu" asp-action="Guncelle" asp-route-randevuNotID="@not.RandevuNotID" class="btn btn-sm btn-warning">Düzenle</a>
                            }

                            @if (not.SonrakiRandevuTarihi.HasValue)
                            {
                                <a asp-controller="Randevu" asp-action="Ekle"
                                   asp-route-hastaTC="@Model.HastaTC"
                                   asp-route-doktorID="@not.DoktorID"
                                   asp-route-tarih="@not.SonrakiRandevuTarihi.Value.ToString("yyyy-MM-dd")"
                                   class="btn btn-sm btn-primary">
                                    Randevu Al
                                </a>
                            }
                        </div>
                    </div>
                </div>
            }
        }
    </div>
</div>

@* sekmelerdeyken başka işlemler yaptığımızda aynı sekmeye tekrar yönlendirsin, geri çıkmasın diye  *@
@section Scripts { 
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var params = new URLSearchParams(window.location.search);
            var sekme = params.get('tab');
            if (sekme) {
                var sekmeButonu = document.querySelector('[data-bs-target="#' + sekme + '"]');
                if (sekmeButonu) {
                    var bsTab = new bootstrap.Tab(sekmeButonu);
                    bsTab.show();
                }
            }
        });
    </script>
}