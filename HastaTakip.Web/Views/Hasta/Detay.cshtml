@model HastaTakip.Entities.Hasta

@{
    ViewData["Title"] = "Hasta Detayı";
}

<h2>@Model.HastaAd @Model.HastaSoyad</h2>

@if (TempData["BasariMesaji"] != null)
{
    <div class="alert alert-success">@TempData["BasariMesaji"]</div>
}

<ul class="nav nav-tabs mb-3" role="tablist">
    <li class="nav-item">
        <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#genelBilgiler" type="button">
            Genel Bilgiler
        </button>
    </li>
    <li class="nav-item">
        <button class="nav-link" data-bs-toggle="tab" data-bs-target="#taniTedavi" type="button">
            Tanı / Tedavi
        </button>
    </li>
    <li class="nav-item">
        <button class="nav-link" data-bs-toggle="tab" data-bs-target="#testOlcek" type="button">
            Test / Ölçek
        </button>
    </li>
    <li class="nav-item">
        <button class="nav-link" data-bs-toggle="tab" data-bs-target="#aileGelisim" type="button">
            Aile / Gelişim
        </button>
    </li>
    <li class="nav-item">
        <button class="nav-link" data-bs-toggle="tab" data-bs-target="#gecmisRandevular" type="button">
            Randevular
        </button>
    </li>
    <li class="nav-item">
        <button class="nav-link" data-bs-toggle="tab" data-bs-target="#randevuNotlari" type="button">
            Randevu Notları
        </button>
    </li>
</ul>

<div class="tab-content">
    <div class="tab-pane fade show active" id="genelBilgiler">
        <dl class="row">
            <dt class="col-sm-3">Dosya No</dt>
            <dd class="col-sm-9">@Model.HastaDosyaNo</dd>

            <dt class="col-sm-3">TC Kimlik No</dt>
            <dd class="col-sm-9">@Model.HastaTC</dd>

            <dt class="col-sm-3">Telefon</dt>
            <dd class="col-sm-9">@Model.HastaTel</dd>

            <dt class="col-sm-3">Adres</dt>
            <dd class="col-sm-9">@Model.HastaAdres</dd>

            <dt class="col-sm-3">Cinsiyet</dt>
            <dd class="col-sm-9">@Model.HastaCinsiyet</dd>

            <dt class="col-sm-3">Doğum Tarihi</dt>
            <dd class="col-sm-9">@Model.HastaDogumTarihi.ToString("dd.MM.yyyy")</dd>

            <dt class="col-sm-3">Okul</dt>
            <dd class="col-sm-9">@Model.HastaOkul</dd>

            <dt class="col-sm-3">Sınıf</dt>
            <dd class="col-sm-9">@Model.HastaSinif</dd>

            <dt class="col-sm-3">Okul Başarısı</dt>
            <dd class="col-sm-9">@Model.HastaOkulBasarisi</dd>

            <dt class="col-sm-3">Boy / Kilo</dt>
            <dd class="col-sm-9">@Model.HastaBoy cm / @Model.HastaKilo kg</dd>

            <dt class="col-sm-3">Yönlendiren</dt>
            <dd class="col-sm-9">@Model.HastaYonlendiren</dd>

            <dt class="col-sm-3">Başvuru Nedeni</dt>
            <dd class="col-sm-9">@Model.HastaBasvuruNedeni</dd>

            <dt class="col-sm-3">Başvuru Tarihi</dt>
            <dd class="col-sm-9">@Model.HastaBasvuruTarihi.ToString("dd.MM.yyyy")</dd>

            <dt class="col-sm-3">Durum</dt>
            <dd class="col-sm-9">@(Model.HastaAktif ? "Aktif" : "Pasif")</dd>
        </dl>

        <a asp-action="Index" class="btn btn-secondary">Listeye Dön</a>
        <a asp-action="Guncelle" asp-route-tc="@Model.HastaTC" class="btn btn-warning">Düzenle</a>
        <a asp-controller="Randevu" asp-action="Ekle" asp-route-hastaTC="@Model.HastaTC" class="btn btn-primary">Randevu Oluştur</a>
    </div>

    <div class="tab-pane fade" id="taniTedavi">
        @{
            var tanilar = (List<HastaTakip.Entities.HastaTani>)ViewBag.Tanilar;
            var tedaviler = (List<HastaTakip.Entities.HastaTedavi>)ViewBag.Tedaviler;
            var taniSozlugu = (Dictionary<short, HastaTakip.Entities.Tani>)ViewBag.TaniSozlugu;
            var ilacSozlugu = (Dictionary<short, HastaTakip.Entities.Ilac>)ViewBag.IlacSozlugu;
            var doktorlarSozluk = (Dictionary<short, HastaTakip.Entities.Doktor>)ViewBag.Doktorlar;
        }

        <h5>Tanılar</h5>
        <a asp-controller="Tani" asp-action="Ekle" asp-route-hastaTC="@Model.HastaTC" class="btn btn-sm btn-primary mb-2">Tanı Ekle</a>

        @if (tanilar.Count == 0)
        {
            <p class="text-muted">Kayıtlı tanı bulunmuyor.</p>
        }
        else
        {
            <table class="table table-sm table-striped">
                <thead><tr><th>Tarih</th><th>Tanı Adı</th><th>Tanı Kodu</th><th>Doktor</th><th>Mental Durum Muayenesi</th><th>İşlemler</th></tr></thead>
                <tbody>
                    @foreach (var t in tanilar)
                    {
                        <tr>
                            <td>@t.TaniTarih.ToString("dd.MM.yyyy")</td>
                            <td>@(taniSozlugu.TryGetValue(t.TaniID, out var tani) ? tani.TaniAdi : "-")</td>
                            <td>@(taniSozlugu.TryGetValue(t.TaniID, out var taniKod) ? taniKod.TaniKodu : "-")</td>
                            <td>@(doktorlarSozluk.TryGetValue(t.DoktorID, out var d1) ? $"{d1.DoktorAd} {d1.DoktorSoyad}" : "-")</td>
                            <td>@(t.MentalDurumMuayenesi ?? "-")</td>
                            <td>
                                <a asp-controller="Tani" asp-action="Guncelle" asp-route-hastaTaniID="@t.HastaTaniID" class="btn btn-sm btn-warning">Düzenle</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }

        <hr />

        <h5>Tedaviler</h5>
        <a asp-controller="Tedavi" asp-action="Ekle" asp-route-hastaTC="@Model.HastaTC" class="btn btn-sm btn-primary mb-2">Tedavi Ekle</a>
        @if (tedaviler.Count == 0)
        {
            <p class="text-muted">Kayıtlı tedavi bulunmuyor.</p>
        }
        else
        {
            <table class="table table-sm table-striped">
                <thead><tr><th>İlaç</th><th>Doz</th><th>Başlangıç Tarihi</th><th>Bitiş Tarihi</th><th>Doktor</th><th>Yan Etkiler</th><th>Tedavi Notları</th><th>İşlemler</th></tr></thead>
                <tbody>
                    @foreach (var t in tedaviler)
                    {
                        <tr>
                            <td>@(ilacSozlugu.TryGetValue(t.IlacID, out var ilac) ? ilac.IlacAdi : "-")</td>
                            <td>@t.IlacDozu</td>
                            <td>@(t.IlacBaslangicTarihi?.ToString("dd.MM.yyyy") ?? "-")</td>
                            <td>@(t.IlacBitisTarihi?.ToString("dd.MM.yyyy") ?? "-")</td>
                            <td>@(doktorlarSozluk.TryGetValue(t.DoktorID, out var d2) ? $"{d2.DoktorAd} {d2.DoktorSoyad}" : "-")</td>
                            <td>@t.IlacYanEtkiler</td>
                            <td>@t.TedaviNotlari</td>
                            <td>
                                <a asp-controller="Tedavi" asp-action="Guncelle" asp-route-tedaviID="@t.TedaviID" class="btn btn-sm btn-warning">Düzenle</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>

    <div class="tab-pane fade" id="testOlcek">
    @{
        var testSonuclari = (List<HastaTakip.Entities.TestSonuc>)ViewBag.TestSonuclari;
        var olcekSonuclari = (List<HastaTakip.Entities.OlcekSonuc>)ViewBag.OlcekSonuclari;
        var testSozlugu = (Dictionary<byte, HastaTakip.Entities.Test>)ViewBag.TestSozlugu;
        var olcekSozlugu = (Dictionary<byte, HastaTakip.Entities.Olcek>)ViewBag.OlcekSozlugu;
        var psikologSozlugu = (Dictionary<byte, HastaTakip.Entities.Psikolog>)ViewBag.PsikologSozlugu;
        var altKumeSonuclariSozluk = (Dictionary<int, List<HastaTakip.Entities.AltKumeSonuc>>)ViewBag.AltKumeSonuclariSozluk;
        var altKumeAdSozlugu = (Dictionary<byte, HastaTakip.Entities.TestAltKume>)ViewBag.AltKumeAdSozlugu;
    }

    <h5>Test Sonuçları</h5>
    <a asp-controller="TestSonuc" asp-action="Ekle" asp-route-hastaTC="@Model.HastaTC" class="btn btn-sm btn-primary mb-2">Test Sonucu Ekle</a>

    @if (testSonuclari.Count == 0)
    {
        <p class="text-muted">Kayıtlı test sonucu bulunmuyor.</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-sm table-striped">
                <thead>
                    <tr>
                        <th>Tarih</th>
                        <th>Test</th>
                        <th>Psikolog</th>
                        <th>Sonuç</th>
                        <th>Değerlendirme</th>
                        <th>İşlem</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var ts in testSonuclari)
                    {
                        <tr>
                            <td>@ts.TestTarih.ToString("dd.MM.yyyy")</td>
                            <td>@(testSozlugu.TryGetValue(ts.TestID, out var test) ? test.TestAdi : "-")</td>
                            <td>@(psikologSozlugu.TryGetValue(ts.PsikologID, out var psi) ? $"{psi.PsikologAd} {psi.PsikologSoyad}" : "-")</td>
                            <td>@(ts.SonucDegeri ?? "-")</td>
                            <td>@(ts.TestDegerlendirme ?? "-")</td>
                            <td>
                                <a asp-controller="TestSonuc" asp-action="Guncelle" asp-route-testSonucID="@ts.TestSonucID" class="btn btn-sm btn-warning">Düzenle</a>
                            </td>
                        </tr>

                            var altKumeler = altKumeSonuclariSozluk.TryGetValue(ts.TestSonucID, out var akList)
                                ? akList
                                : new List<HastaTakip.Entities.AltKumeSonuc>();
                        
                        @if (altKumeler.Count > 0)
                        {
                            <tr>
                                <td></td>
                                <td colspan="5">
                                    <table class="table table-sm table-bordered mb-0">
                                        <thead>
                                            <tr><th>Alt Küme</th><th>Sonuç</th><th>Yorum</th></tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var ak in altKumeler)
                                            {
                                                <tr>
                                                    <td>@(altKumeAdSozlugu.TryGetValue(ak.AltKumeID, out var akAd) ? akAd.TestAltKumeAdi : "-")</td>
                                                    <td>@(ak.AltKumeSonucDeger ?? "-")</td>
                                                    <td>@(ak.AltKumeYorum ?? "-")</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    }

    <hr />

    <h5>Ölçek Sonuçları</h5>
    <a asp-controller="OlcekSonuc" asp-action="Ekle" asp-route-hastaTC="@Model.HastaTC" class="btn btn-sm btn-primary mb-2">Ölçek Sonucu Ekle</a>
    @if (olcekSonuclari.Count == 0)
    {
        <p class="text-muted">Kayıtlı ölçek sonucu bulunmuyor.</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-sm table-striped">
                <thead>
                    <tr>
                        <th>Tarih</th>
                        <th>Ölçek</th>
                        <th>Doktor</th>
                        <th>Puan</th>
                        <th>Yorum</th>
                        <th>Uygulanan</th>
                        <th>İşlem</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var os in olcekSonuclari)
                    {
                        <tr>
                            <td>@os.OlcekTarih.ToString("dd.MM.yyyy")</td>
                            <td>@(olcekSozlugu.TryGetValue(os.OlcekID, out var olcek) ? olcek.OlcekAdi : "-")</td>
                            <td>@(doktorlarSozluk.TryGetValue(os.DoktorID, out var d3) ? $"{d3.DoktorAd} {d3.DoktorSoyad}" : "-")</td>
                            <td>@(os.OlcekPuan?.ToString() ?? "-")</td>
                            <td>@(os.OlcekYorum ?? "-")</td>
                            <td>@(os.OlcekUygulanan ?? "-")</td>
                            <td>
                                <a asp-controller="OlcekSonuc" asp-action="Guncelle" asp-route-olcekSonucID="@os.OlcekSonucID" class="btn btn-sm btn-warning">Düzenle</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
    
    <div class="tab-pane fade" id="aileGelisim">
        <p class="text-muted">Yakında — Aile bilgileri ve gelişimsel öykü burada görüntülenecek.</p>
    </div>
    <div class="tab-pane fade" id="gecmisRandevular">
        @{
            var randevular = (List<HastaTakip.Entities.RandevuTarihi>)ViewBag.GecmisRandevular;
            var doktorlar = (Dictionary<short, HastaTakip.Entities.Doktor>)ViewBag.Doktorlar;
            var saatler = (Dictionary<byte, HastaTakip.Entities.RandevuSaat>)ViewBag.Saatler;
        }

        @if (randevular.Count == 0)
        {
            <p class="text-muted">Bu hastaya ait randevu kaydı bulunmuyor.</p>
        }
        else
        {
            <table class="table table-striped">
                <thead>
                    <tr>
                        <th>Tarih</th>
                        <th>Saat</th>
                        <th>Doktor</th>
                        <th>Durum</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var randevu in randevular)
                    {
                        <tr>
                            <td>@randevu.RandevuTarih.ToString("dd.MM.yyyy")</td>
                            <td>
                                @if (saatler.TryGetValue(randevu.SaatID, out var saat))
                                {
                                    @saat.RandevuBaslangicSaat.ToString(@"hh\:mm")
                                }
                            </td>
                            <td>
                                @if (doktorlar.TryGetValue(randevu.DoktorID, out var doktor))
                                {
                                    @($"{doktor.DoktorAd} {doktor.DoktorSoyad}")
                                }
                            </td>
                            <td>
                                @{
                                    var renk = randevu.RandevuDurum switch
                                    {
                                        "Tamamlandı" => "bg-success",
                                        "İptal" => "bg-secondary",
                                        "Gelmedi" => "bg-danger",
                                        _ => "bg-primary"
                                    };
                                }
                                <span class="badge @renk">@randevu.RandevuDurum</span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
    <div class="tab-pane fade" id="randevuNotlari">
        @{
            var randevuNotlari = (List<HastaTakip.Entities.RandevuNotu>)ViewBag.RandevuNotlari;
            var randevuSozlugu = (Dictionary<int, HastaTakip.Entities.RandevuTarihi>)ViewBag.RandevuSozlugu;
        }

        <a asp-controller="Randevu" asp-action="Index" asp-route-hastaTC="@Model.HastaTC" class="btn btn-sm btn-primary mb-2">
            Randevu Notu Ekle
        </a>

        @if (randevuNotlari.Count == 0)
        {
            <p class="text-muted">Bu hastaya ait randevu notu bulunmuyor.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-sm table-striped">
                    <thead>
                        <tr>
                            <th>Randevu Tarihi</th>
                            <th>Doktor</th>
                            <th>Görüşme Tipi</th>
                            <th>Görüşme Notu</th>
                            <th>Sonraki Randevu Tarihi</th>
                            <th>İşlem</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var not in randevuNotlari)
                        {
                            <tr>
                                <td>
                                    @(randevuSozlugu.TryGetValue(not.RandevuTarihID, out var randevu)
                                        ? randevu.RandevuTarih.ToString("dd.MM.yyyy")
                                        : "-")
                                </td>
                                <td>@(doktorlarSozluk.TryGetValue(not.DoktorID, out var dNot) ? $"{dNot.DoktorAd} {dNot.DoktorSoyad}" : "-")</td>
                                <td>@(not.GorusmeTipi ?? "-")</td>
                                <td>@(not.GorusmeNotu ?? "-")</td>
                                <td>@(not.SonrakiRandevuTarihi?.ToString("dd.MM.yyyy") ?? "-")</td>
                                <td>
                                    <a asp-controller="RandevuNotu" asp-action="Guncelle" asp-route-randevuNotID="@not.RandevuNotID" class="btn btn-sm btn-warning">Düzenle</a>

                                    @if (not.SonrakiRandevuTarihi.HasValue)
                                    {
                                        <a asp-controller="Randevu" asp-action="Ekle"
                                           asp-route-hastaTC="@Model.HastaTC"
                                           asp-route-doktorID="@not.DoktorID"
                                           asp-route-tarih="@not.SonrakiRandevuTarihi.Value.ToString("yyyy-MM-dd")"
                                           asp-route-kaynak="randevuNotu"
                                           class="btn btn-sm btn-primary">
                                            Randevu Al
                                        </a>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@* sekmelerdeyken başka işlemler yaptığımızda aynı sekmeye tekrar yönlendirsin, geri çıkmasın diye  *@
@section Scripts { 
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var params = new URLSearchParams(window.location.search);
            var sekme = params.get('tab');
            if (sekme) {
                var sekmeButonu = document.querySelector('[data-bs-target="#' + sekme + '"]');
                if (sekmeButonu) {
                    var bsTab = new bootstrap.Tab(sekmeButonu);
                    bsTab.show();
                }
            }
        });
    </script>
}