@{
    ViewData["Title"] = "Aile Öyküsü Ekle";
}

<h2>Aile Öyküsü Ekle</h2>

<form asp-action="Ekle" method="post">
    <input type="hidden" name="HastaTC" value="@ViewBag.HastaTC" />

    <div class="row">
        <div class="col-md-6">
            <label class="form-label">Anne-Babanın Kişisel Öyküsü</label>
            <textarea name="AnneBabaninKisiselOykusu" class="form-control" rows="4"></textarea>
        </div>
        <div class="col-md-6">
            <label class="form-label">Anne-Babanın Evlilik Öyküsü</label>
            <textarea name="AnneBabaninEvlilikOykusu" class="form-control" rows="4"></textarea>
        </div>
        <div class="col-md-6">
            <label class="form-label">Aile Özellikleri</label>
            <textarea name="AileOzellikleri" class="form-control" rows="4"></textarea>
        </div>
        <div class="col-md-6">
            <label class="form-label">Anne-Baba Kardeşleri</label>
            <textarea name="AnneBabaKardesler" class="form-control" rows="4"></textarea>
        </div>
    </div>

    <button type="submit" class="btn btn-primary mt-3">Kaydet</button>
    <a asp-controller="Hasta" asp-action="Detay" asp-route-tc="@ViewBag.HastaTC" asp-route-tab="aileGelisim" class="btn btn-secondary mt-3">İptal</a>
</form>