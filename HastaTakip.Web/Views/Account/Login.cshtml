@{
    ViewData["Title"] = "Giriş";
    Layout = null;
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Giriş - Hasta Takip Sistemi</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <style>
            body {
                min-height: 100vh;
                display: flex;
                align-items: center;
                justify-content: center;
                background: linear-gradient(135deg, #f5f7fa 0%, #e4e9f0 100%);
                font-family: 'Segoe UI', system-ui, sans-serif;
            }

            .login-card {
                width: 100%;
                max-width: 400px;
                background: #fff;
                border-radius: 12px;
                box-shadow: 0 10px 30px rgba(0, 0, 0, 0.15);
                padding: 2.5rem 2rem;
            }

            .login-icon {
                width: 64px;
                height: 64px;
                border-radius: 50%;
                background: #e7f1ff;
                display: flex;
                align-items: center;
                justify-content: center;
                margin: 0 auto 1rem;
                font-size: 28px;
            }

            .login-title {
                text-align: center;
                font-weight: 600;
                margin-bottom: 0.25rem;
            }

            .login-subtitle {
                text-align: center;
                color: #6c757d;
                font-size: 0.9rem;
                margin-bottom: 1.75rem;
            }

            .form-control {
                padding: 0.6rem 0.9rem;
            }

            .btn-login {
                padding: 0.6rem;
                font-weight: 500;
            }

            .sifre-wrapper {
                position: relative;
            }

                .sifre-wrapper input {
                    padding-right: 2.5rem;
                }

            .sifre-goz {
                position: absolute;
                right: 0.75rem;
                top: 50%;
                transform: translateY(-50%);
                cursor: pointer;
                background: none;
                border: none;
                font-size: 1.1rem;
                color: #6c757d;
                padding: 0;
            }
    </style>
</head>
<body>
    <div class="login-card">
        <div class="login-icon">🏥</div>
        <h4 class="login-title">Hasta Takip Sistemi</h4>
        <p class="login-subtitle">Devam etmek için giriş yapın</p>

        @if (ViewBag.Hata != null)
        {
            <div class="alert alert-danger py-2 small" role="alert">
                @ViewBag.Hata
            </div>
        }

        <form asp-action="Login" asp-controller="Account" method="post">
            <div class="mb-3">
                <label class="form-label">Kullanıcı Adı</label>
                <input type="text" name="kullaniciAdi" class="form-control" placeholder="Kullanıcı adınız" required autofocus />
            </div>

            <div class="mb-4">
                <label class="form-label">Şifre</label>
                <div class="sifre-wrapper">
                    <input type="password" name="sifre" id="sifreInput" class="form-control" placeholder="Şifreniz" required />
                    <button type="button" class="sifre-goz" onclick="sifreGosterGizle('sifreInput', this)">👁</button>
                </div>
            </div>

            <button type="submit" class="btn btn-primary w-100 btn-login">Giriş Yap</button>

        </form>
    </div>
    <script>
            function sifreGosterGizle(inputId, buton) {
                var input = document.getElementById(inputId);
                if (input.type === 'password') {
                    input.type = 'text';
                    buton.textContent = '🙈';
                } else {
                    input.type = 'password';
                    buton.textContent = '👁';
                }
            }
    </script>
</body>
</html>