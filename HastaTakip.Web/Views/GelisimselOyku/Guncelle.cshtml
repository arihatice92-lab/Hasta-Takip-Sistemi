@model HastaTakip.Entities.GelisimselOyku
@{
    ViewData["Title"] = "Gelişimsel Öykü Güncelle";
}

<h2>Gelişimsel Öykü Güncelle</h2>

<form asp-action="Guncelle" method="post">
    <input type="hidden" asp-for="GelisimOykuID" />
    <input type="hidden" asp-for="HastaTC" />

    <h5>Doğum</h5>
    <div class="row">
        <div class="col-md-2"><label class="form-label">Doğumda Anne Yaşı</label><input asp-for="DogumAnneYasi" type="number" class="form-control" /></div>
        <div class="col-md-2"><label class="form-label">Doğumda Baba Yaşı</label><input asp-for="DogumBabaYasi" type="number" class="form-control" /></div>
        <div class="col-md-2"><label class="form-label">Doğum Haftası</label><input asp-for="DogumHaftasi" type="number" class="form-control" /></div>
        <div class="col-md-3">
            <label class="form-label">Doğum Şekli</label>
            <select asp-for="DogumSekli" class="form-select">
                <option value="">Seçiniz</option>
                <option value="NSVY">NSVY</option>
                <option value="Sezaryen">Sezaryen</option>
            </select>
        </div>
        <div class="col-md-3"><label class="form-label">Doğum Ağırlığı (gr)</label><input asp-for="DogumAgirligi" type="number" class="form-control" /></div>

        <div class="col-md-6"><label class="form-label">Doğum Komplikasyonu</label><textarea asp-for="DogumKomplikasyonu" class="form-control"></textarea></div>
        <div class="col-md-3">
            <label class="form-label">Planlı Gebelik mi?</label>
            <select asp-for="PlanliGebelikMi" class="form-select">
                <option value="">-</option>
                <option value="true">Evet</option>
                <option value="false">Hayır</option>
            </select>
        </div>

        <div class="col-md-6"><label class="form-label">Gebe Kalmada Güçlük</label><textarea asp-for="GebeKalmadaGucluk" class="form-control"></textarea></div>
        <div class="col-md-6"><label class="form-label">Ailenin Cinsiyet Beklentisi</label><textarea asp-for="AileCinsiyetBeklentisi" class="form-control"></textarea></div>
        <div class="col-md-12"><label class="form-label">Ailenin Doğuma Tepkisi</label><textarea asp-for="AileDogumaTepki" class="form-control"></textarea></div>
    </div>

    <hr />
    <h5>Motor ve Dil Gelişimi</h5>
    <div class="row">
        <div class="col-md-2"><label class="form-label">Oturma Yaşı (ay)</label><input asp-for="OturmaYasi" type="number" class="form-control" /></div>
        <div class="col-md-2"><label class="form-label">Emekleme Yaşı (ay)</label><input asp-for="EmeklemeYasi" type="number" class="form-control" /></div>
        <div class="col-md-2"><label class="form-label">Yürüme Yaşı (ay)</label><input asp-for="YurumeYasi" type="number" class="form-control" /></div>
        <div class="col-md-3"><label class="form-label">İlk Sözcük Yaşı (ay)</label><input asp-for="IlkSozcukYasi" type="number" class="form-control" /></div>
        <div class="col-md-3"><label class="form-label">İlk Cümle Yaşı (ay)</label><input asp-for="IlkCumleYasi" type="number" class="form-control" /></div>

        <div class="col-md-6"><label class="form-label">Tuvalet Eğitimi</label><textarea asp-for="TuvaletEgitimi" class="form-control"></textarea></div>
        <div class="col-md-6"><label class="form-label">Geçirilen Kaza</label><textarea asp-for="GecirilenKaza" class="form-control"></textarea></div>
    </div>

    <hr />
    <h5>Dönemsel Öykü</h5>
    <div class="row">
        <div class="col-md-6"><label class="form-label">Bebeklik Dönemi</label><textarea asp-for="BebeklikDonemi" class="form-control" rows="3"></textarea></div>
        <div class="col-md-6"><label class="form-label">Çocukluk Dönemi</label><textarea asp-for="CocuklukDonemi" class="form-control" rows="3"></textarea></div>
        <div class="col-md-6"><label class="form-label">Okul Öyküsü</label><textarea asp-for="OkulOykusu" class="form-control" rows="3"></textarea></div>
        <div class="col-md-6"><label class="form-label">Sosyal İlişkileri</label><textarea asp-for="SosyalIliskileri" class="form-control" rows="3"></textarea></div>
        <div class="col-md-6"><label class="form-label">Kişilik Özellikleri</label><textarea asp-for="KisilikOzellikleri" class="form-control" rows="3"></textarea></div>
        
    </div>

    <button type="submit" class="btn btn-primary mt-3">Kaydet</button>
    <a asp-controller="Hasta" asp-action="Detay" asp-route-tc="@Model.HastaTC" asp-route-tab="aileGelisim" class="btn btn-secondary mt-3">İptal</a>
</form>